<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap">

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ad-reference.css' | asset_url | stylesheet_tag }}

    {% comment %}
      Shared policy-page styling for the store's policy pages
      (/policies/privacy-policy, /policies/refund-policy,
      /policies/terms-of-service, /policies/shipping-policy), which Shopify
      renders with its built-in markup (.shopify-policy__*). The rules are
      scoped to policy classes / the .ad-policy wrapper, so loading the file
      on every page is safe and guarantees the design applies to the real
      rendered DOM of every policy route.
    {% endcomment %}
    {{ 'policy-page.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="{% if request.page_type == 'index' %}template-index{% endif %}">
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
{% render 'cart-drawer' %}

    {% comment %}
      Presentation-only polish for the built-in Shopify policy markup:
      1. Wrap the policy content in a full-width .ad-policy area so the
         white background and generous padding render correctly.
      2. If the first body line is an "Effective"/"Last updated" meta line,
         present it neatly below the title. No content is ever changed.
      The script self-guards: on non-policy pages no matching container
      exists and it returns immediately.
    {% endcomment %}
    <script>
      (function () {
        function stylePolicy() {
          var container = document.querySelector('.shopify-policy__container, #shopify-policy__container, .ad-policy__container, .shopify-policy__wrap, #shopify-policy');
          if (!container) return;

          // Climb to the OUTERMOST native policy wrapper so the whole
          // policy block is wrapped once - .ad-policy becomes the single
          // horizontal-padding owner and no double-padding can occur.
          var root = container;
          while (root.parentElement && (' ' + root.parentElement.className + ' ').indexOf('shopify-policy') !== -1) {
            root = root.parentElement;
          }

          var hasNativePolicy = !!document.querySelector('.shopify-policy__container, #shopify-policy__container, .shopify-policy__wrap, #shopify-policy');
          if (hasNativePolicy && !root.closest('.ad-policy')) {
            var outer = document.createElement('div');
            outer.className = 'ad-policy';
            root.parentNode.insertBefore(outer, root);
            outer.appendChild(root);
          }

          var body = container.querySelector('.shopify-policy__body, .ad-policy__body');
          if (body && body.firstElementChild) {
            var firstText = (body.firstElementChild.textContent || '').trim().replace(/\s+/g, ' ');
            if (/^(effective|last updated|updated|as of|effective date)/i.test(firstText)) {
              body.firstElementChild.classList.add('ad-policy__meta');
            }
          }
        }

        function onReady() {
          stylePolicy();
          if (!document.querySelector('.shopify-policy__container, #shopify-policy__container')) {
            window.setTimeout(stylePolicy, 300);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', onReady);
        } else {
          onReady();
        }
      })();
    </script>
  </body>
</html>
