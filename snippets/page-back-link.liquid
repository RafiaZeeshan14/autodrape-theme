{% doc %}
  Renders a page-level back link that returns to the previous same-site page,
  with the home page as a safe fallback.

  @example
  {% render 'page-back-link' %}
{% enddoc %}

<a class="ad-page-back" href="{{ routes.root_url }}" data-ad-page-back>
  <span aria-hidden="true">&#8592;</span>
  <span>Back</span>
</a>

<script>
  (function () {
    var link = document.querySelector('[data-ad-page-back]');
    if (!link || !document.referrer) return;

    try {
      var previous = new URL(document.referrer);
      if (previous.origin === window.location.origin) link.href = document.referrer;
    } catch (error) {
      // Keep the home-page fallback when the referrer cannot be read.
    }
  }());
</script>

<style>
  .ad-page-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #a90000;
    font: 800 12px/1 var(--font-ui--family);
    letter-spacing: .04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color .2s ease, transform .2s ease;
  }

  .ad-page-back:hover {
    color: #850000;
    transform: translateX(-2px);
  }

  .ad-page-back span:first-child {
    font-size: 17px;
    line-height: .7;
  }
</style>
