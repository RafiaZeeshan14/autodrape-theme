{% doc %}
  Renders the premium Contact Us page with contact details and support options.

  @example
  {% render 'contact-page-content' %}
{% enddoc %}

<section class="ad-contact-page">
  <div class="ad-contact-page__inner">
    <div class="ad-contact-page__intro">
      <a class="ad-contact-page__back" href="{{ routes.root_url }}">&#8592; Back</a>
      <p class="ad-contact-page__eyebrow">Get in touch</p>
      <h1>Let&rsquo;s talk about your car.</h1>
      <p class="ad-contact-page__lead">Have a question about fit, coverage or your order? Our team is ready to help you find the right shade.</p>

      <div class="ad-contact-page__details">
        <a href="tel:+923001234567">
          <span class="ad-contact-page__detail-label">Call</span>
          <span>+92 300 1234567</span>
        </a>
        <a href="mailto:info@autodrapes.com">
          <span class="ad-contact-page__detail-label">Email</span>
          <span>info@autodrapes.com</span>
        </a>
        <div>
          <span class="ad-contact-page__detail-label">Visit</span>
          <span>Karachi, Pakistan</span>
        </div>
      </div>
    </div>

    <div class="ad-contact-page__support-wrap">
      <div class="ad-contact-page__form-heading">
        <p class="ad-contact-page__eyebrow">Customer support</p>
        <h2>Here when you need us.</h2>
        <p>Choose the easiest way to reach our team.</p>
      </div>

      <div class="ad-contact-page__support-list">
        <a class="ad-contact-page__support-card" href="tel:+923001234567">
          <span class="ad-contact-page__support-icon">01</span>
          <span>
            <strong>Call our team</strong>
            <small>+92 300 1234567</small>
          </span>
          <span class="ad-contact-page__support-arrow" aria-hidden="true">&#8594;</span>
        </a>
        <a class="ad-contact-page__support-card" href="mailto:info@autodrapes.com">
          <span class="ad-contact-page__support-icon">02</span>
          <span>
            <strong>Email support</strong>
            <small>info@autodrapes.com</small>
          </span>
          <span class="ad-contact-page__support-arrow" aria-hidden="true">&#8594;</span>
        </a>
      </div>

      <div class="ad-contact-page__availability">
        <span class="ad-contact-page__availability-dot"></span>
        <span><strong>Support available</strong><small>We usually respond within one business day.</small></span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ad-contact-page {
    padding: clamp(48px, 7vw, 96px) 20px clamp(64px, 8vw, 110px);
    background: #f8f8f7;
  }

  .ad-contact-page__inner {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    max-width: 1180px;
    min-height: 620px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgba(17, 17, 17, .08);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 24px 70px rgba(17, 17, 17, .09);
  }

  .ad-contact-page__intro {
    position: relative;
    padding: clamp(34px, 5vw, 68px);
    color: #fff;
    background: radial-gradient(circle at 15% 15%, rgba(217, 0, 0, .3), transparent 30%), linear-gradient(145deg, #191919, #070707);
  }

  .ad-contact-page__back {
    display: inline-flex;
    margin-bottom: clamp(70px, 10vw, 140px);
    color: #fff;
    font: 800 13px/1 var(--font-ui--family), sans-serif;
    letter-spacing: .04em;
    text-decoration: none;
  }

  .ad-contact-page__eyebrow {
    margin: 0 0 14px;
    color: #d90000;
    font: 800 12px/1 var(--font-ui--family), sans-serif;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .ad-contact-page__intro h1 {
    max-width: 440px;
    margin: 0;
    color: #fff;
    font: 900 clamp(40px, 5vw, 72px)/.98 var(--font-ui--family), sans-serif;
    letter-spacing: -.065em;
  }

  .ad-contact-page__lead {
    max-width: 430px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, .7);
    font: 400 16px/1.65 var(--font-ui--family), sans-serif;
  }

  .ad-contact-page__details {
    display: grid;
    gap: 18px;
    margin-top: 58px;
  }

  .ad-contact-page__details a,
  .ad-contact-page__details div {
    display: grid;
    gap: 5px;
    color: #fff;
    font: 500 15px/1.4 var(--font-ui--family), sans-serif;
    text-decoration: none;
  }

  .ad-contact-page__detail-label {
    color: rgba(255, 255, 255, .48);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .ad-contact-page__support-wrap {
    padding: clamp(34px, 5vw, 68px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ad-contact-page__form-heading h2 {
    margin: 0;
    color: #111;
    font: 900 clamp(28px, 3vw, 42px)/1.05 var(--font-ui--family), sans-serif;
    letter-spacing: -.05em;
  }

  .ad-contact-page__form-heading > p:last-child {
    margin: 12px 0 34px;
    color: #707070;
    font: 400 15px/1.5 var(--font-ui--family), sans-serif;
  }

  .ad-contact-page__support-list { display: grid; gap: 12px; }
  .ad-contact-page__support-card {
    display: grid;
    grid-template-columns: 42px 1fr auto;
    align-items: center;
    gap: 15px;
    padding: 18px;
    border: 1px solid #e2e2e2;
    border-radius: 12px;
    color: #111;
    text-decoration: none;
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .ad-contact-page__support-card:hover { border-color: #d90000; transform: translateY(-2px); box-shadow: 0 10px 24px rgba(17, 17, 17, .08); }
  .ad-contact-page__support-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; color: #fff; background: #d90000; font: 800 11px/1 var(--font-ui--family), sans-serif; }
  .ad-contact-page__support-card strong, .ad-contact-page__availability strong { display: block; font: 800 13px/1.3 var(--font-ui--family), sans-serif; }
  .ad-contact-page__support-card small, .ad-contact-page__availability small { display: block; margin-top: 4px; color: #777; font: 400 13px/1.4 var(--font-ui--family), sans-serif; }
  .ad-contact-page__support-arrow { color: #d90000; font-size: 22px; }
  .ad-contact-page__availability { display: flex; align-items: center; gap: 11px; margin-top: 30px; padding-top: 22px; border-top: 1px solid #e5e5e5; }
  .ad-contact-page__availability-dot { width: 9px; height: 9px; border-radius: 50%; background: #1d9b5a; box-shadow: 0 0 0 5px rgba(29, 155, 90, .12); }

  @media screen and (max-width: 700px) {
    .ad-contact-page { padding: 28px 14px 60px; }
    .ad-contact-page__inner { display: block; border-radius: 20px; }
    .ad-contact-page__intro, .ad-contact-page__support-wrap { padding: 30px 22px; }
    .ad-contact-page__back { margin-bottom: 64px; }
    .ad-contact-page__details { margin-top: 40px; }
  }
{% endstylesheet %}
