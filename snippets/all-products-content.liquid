{% doc %}
  Renders the "All Products" page content.

  Dynamically renders the four AutoDrape Shopify products (Front Window
  Shield, Rear/Back Window Shield, Full Window Coverage, Half Window
  Coverage) fetched from the store's product records. Each card shows the
  product image, title, short description, price and a SHOP NOW link.

  Used by both the `autodrape-all-products` section (via the
  `page.all-products` template) and the default page template fallback (so
  `/pages/all-products` renders correctly without an admin template
  assignment).

  @example
  {% render 'all-products-content' %}
{% enddoc %}

<section class="autodrape-all-products">
  <div class="autodrape-all-products__inner">
    <header class="autodrape-all-products__header">
      {% render 'page-back-link' %}
      <h1>ALL <span>PRODUCTS</span></h1>
      <p class="autodrape-all-products__intro">Premium car shades &amp; accessories for every drive.</p>
    </header>

    <div class="autodrape-all-products__grid">
      {% liquid
        assign product_handles = 'front-window-shield,rear-window-shield,full-window-coverage-sunshades,half-window-coverae-sunshades' | split: ','
      %}
      {% for handle in product_handles %}
        {% assign product = all_products[handle] %}
        {% if product %}
          {% render 'product-card', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .autodrape-all-products {
    padding: 72px 24px 96px;
    background: #fff;
    color: #111;
  }

  .autodrape-all-products__inner {
    width: min(100%, 1200px);
    margin: 0 auto;
  }

  .autodrape-all-products__header {
    position: relative;
    margin: 0 auto 38px;
    text-align: center;
  }

  .autodrape-all-products__header h1 {
    margin: 0;
    font-family: var(--font-ui--family) !important;
    font-size: 42px;
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .autodrape-all-products__header h1 span {
    color: #d90000;
  }

  .autodrape-all-products__header .ad-page-back {
    position: absolute;
    top: 0;
    left: 0;
  }

  .autodrape-all-products__intro {
    margin: 14px 0 0;
    color: #666;
    font-family: var(--font-ui--family);
    font-size: 14px;
  }

  .autodrape-all-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .product-card { display:flex; flex-direction:column; min-width:0; overflow:hidden; border:1px solid #eee; border-radius:8px; background:#fff; }
  .product-card__image { display:flex; align-items:center; justify-content:center; aspect-ratio:4 / 5; padding:12px; background:#f6f6f6; }
  .product-card__image img { width:100%; height:100%; object-fit:contain; }
  .product-card__body { display:flex; flex:1; flex-direction:column; gap:8px; padding:12px; }
  .product-card__name { margin:0; font-family:var(--font-ui--family); font-size:13px; font-weight:700; line-height:1.3; color:#222; }
  .product-card__desc { margin:0; font-family:var(--font-ui--family); font-size:12px; line-height:1.45; color:#666; }
  .product-card__price { margin:0; margin-top:auto; font-family:var(--font-ui--family); font-size:15px; font-weight:800; color:#a90000; }
  .product-card__btn { display:inline-block; padding:8px 10px; border-radius:6px; background:#d90000; color:#fff; font-family:var(--font-ui--family); font-size:13px; font-weight:700; text-align:center; text-decoration:none; }

  @media screen and (max-width: 1100px) {
    .autodrape-all-products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 700px) {
    .autodrape-all-products { padding: 52px 14px 72px; }
    .autodrape-all-products__header h1 { font-size: 32px; line-height: 1.05; }
    .autodrape-all-products__header .ad-page-back {
      position: static;
      display: flex;
      width: max-content;
      margin: 0 0 22px;
    }
    .autodrape-all-products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .product-card__image { padding: 8px; }
  }
</style>
