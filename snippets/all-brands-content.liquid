{% doc %}
  Renders the "All Brands" directory page.

  Loops every record from the existing `car_brand` metaobject and shows each
  brand logo + name as a card linking into the brand → model → year →
  compatible products selection flow.

  Used by both the `autodrape-all-brands` section and the default page
  template fallback (so `/pages/all-brands` works without an admin template
  assignment). New brands added in Shopify appear automatically.

  @example
  {% render 'all-brands-content' %}
{% enddoc %}
{% render 'vehicle-heading-font' %}


<section class="autodrape-all-brands">
  <div class="autodrape-all-brands__container">

    <div class="autodrape-all-brands__header">
      <h1>ALL <span>BRANDS</span></h1>
      <p>Choose your car brand to find the perfect fit.</p>
    </div>

            {% assign car_brands = metaobjects.car_brand.values %}

    <div class="autodrape-brands-grid">

      {% for brand in car_brands %}

        <a
          href="/pages/shop-by-car?brand={{ brand.system.handle | url_encode }}"
          class="autodrape-brand-card"
        >

          <div class="autodrape-brand-card__logo">
            {% if brand.brand_logo.value %}
              {{
                brand.brand_logo.value
                | image_url: width: 300
                | image_tag:
                  loading: 'lazy',
                  alt: brand.brand_name.value
              }}
            {% endif %}
          </div>

          <div class="autodrape-brand-card__name">
            {{ brand.brand_name.value }}
          </div>

        </a>

      {% endfor %}

    </div>

  </div>
</section>

<style>
  .autodrape-all-brands {
    width: 100%;
    background: #fff;
    padding: 52px 24px 96px;
  }

  .autodrape-all-brands__container {
    width: min(1600px, 100%);
    margin: 0 auto;
  }

  .autodrape-all-brands__header {
    position: relative;
    text-align: center;
    margin-bottom: 52px;
  }

  .autodrape-all-brands__header h1 {
    margin: 0;
    font-family: var(--font-ui--family);
    font-size: clamp(42px, 4vw, 60px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1px;
    color: #111;
  }

  .autodrape-all-brands__header h1 span {
    color: #d90000;
  }

  .autodrape-all-brands__header p {
    margin: 10px 0 0;
    font-family: var(--font-ui--family);
    font-size: 17px;
    color: #666;
  }

  .autodrape-brands-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .autodrape-brand-card {
    min-height: 138px;
    padding: 20px 24px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    text-decoration: none;
    transition: all .2s ease;
  }

  .autodrape-brand-card:hover {
    border-color: #a90000;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
  }

  .autodrape-brand-card__logo {
    width: 86px;
    height: 66px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .autodrape-brand-card__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .autodrape-brand-card__name {
    font-family: var(--font-ui--family);
    font-size: 18px;
    font-weight: 700;
    color: #111;
  }

  @media screen and (max-width: 991px) {
    .autodrape-brands-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 640px) {

    .autodrape-all-brands {
      padding: 52px 14px 72px;
    }

    .autodrape-all-brands__header h1 {
      font-size: 32px;
    }

    .autodrape-brands-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .autodrape-brand-card {
      min-height: 126px;
      padding: 14px 10px;
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }

    .autodrape-brand-card__logo {
      width: 72px;
      height: 54px;
    }

    .autodrape-brand-card__name {
      max-width: 100%;
      overflow: hidden;
      font-size: 14px;
      line-height: 1.2;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
