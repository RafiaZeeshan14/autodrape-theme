{% doc %}
  Renders the "All Brands" directory page.

  Loops every record from the existing `car_brand` metaobject and shows each
  brand logo + name as a card linking into the brand → model → year →
  compatible products selection flow.

  Used by both the `autodrape-all-brands` section and the default page
  template fallback (so `/pages/all-brands` works without an admin template
  assignment). New brands added in Shopify appear automatically.

  @example
  {% render 'all-brands-content' %}
{% enddoc %}

<section class="autodrape-all-brands">
  <div class="autodrape-all-brands__container">

    <div class="autodrape-all-brands__header">
      <h1>ALL <span>BRANDS</span></h1>
      <p>Choose your car brand to find the perfect fit.</p>
    </div>

        <!-- REQ-DIAG: probe query string handling -->
    <div style="background:#ffe0e0;border:1px solid #f99;padding:10px;font-size:12px;text-align:left;margin-bottom:20px;">
      request.query_string: [{{ request.query_string }}]
      request.path: [{{ request.path }}]
      <br>
      {% assign qs = request.query_string %}
      {% assign parts = qs | split: '&' %}
      {% assign probe_brand = '' %}
      {% for p in parts %}
        {% assign pair = p | split: '=' %}
        {% assign k = pair[0] | downcase | strip %}
        {% assign v = pair[1] | strip %}
        {% if k == 'brand' %}{% assign probe_brand = v | handleize %}{% endif %}
      {% endfor %}
            parsed brand: [{{ probe_brand }}]
      matched brand name:
      {% for b in metaobjects.car_brand.values %}
        {% assign b_handle = b.system.handle | handleize %}
        {% if b_handle == probe_brand %}[{{ b.brand_name.value }}]{% endif %}
      {% endfor %}
    </div>

    {% assign car_brands = metaobjects.car_brand.values %}

    <div class="autodrape-brands-grid">

      {% for brand in car_brands %}

        <a
          href="/pages/shop-by-car?brand={{ brand.system.handle | url_encode }}"
          class="autodrape-brand-card"
        >

          <div class="autodrape-brand-card__logo">
            {% if brand.brand_logo.value %}
              {{
                brand.brand_logo.value
                | image_url: width: 300
                | image_tag:
                  loading: 'lazy',
                  alt: brand.brand_name.value
              }}
            {% endif %}
          </div>

          <div class="autodrape-brand-card__name">
            {{ brand.brand_name.value }}
          </div>

        </a>

      {% endfor %}

    </div>

  </div>
</section>

<style>
  .autodrape-all-brands {
    width: 100%;
    background: #fff;
    padding: 70px 0 90px;
  }

  .autodrape-all-brands__container {
    width: min(1200px, 92%);
    margin: 0 auto;
  }

  .autodrape-all-brands__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .autodrape-all-brands__header h1 {
    margin: 0;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -1px;
    color: #111;
  }

  .autodrape-all-brands__header h1 span {
    color: #a90000;
  }

  .autodrape-all-brands__header p {
    margin: 10px 0 0;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 15px;
    color: #666;
  }

  .autodrape-brands-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .autodrape-brand-card {
    min-height: 125px;
    padding: 20px 25px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    text-decoration: none;
    transition: all .2s ease;
  }

  .autodrape-brand-card:hover {
    border-color: #a90000;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
  }

  .autodrape-brand-card__logo {
    width: 80px;
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .autodrape-brand-card__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .autodrape-brand-card__name {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #111;
  }

  @media screen and (max-width: 991px) {
    .autodrape-brands-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 640px) {
    .autodrape-all-brands {
      padding: 45px 0 60px;
    }

    .autodrape-all-brands__header h1 {
      font-size: 32px;
    }

    .autodrape-brands-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .autodrape-brand-card {
      min-height: 100px;
      padding: 16px;
    }
  }
</style>