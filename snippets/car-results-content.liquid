{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    var root = document.querySelector('.car-results');
    if (!root) return;

    // Customer-facing shade names and prices stay static in PKR. Live
    // Shopify product data is still used below for images, descriptions and
    // variant IDs so Add to Cart continues to work normally.
    var staticShadeDetails = {
      full: { name: '4-Side Shades (Full Window / Half Window)', amount: 2999 },
      half: { name: '4-Side Shades (Full Window / Half Window)', amount: 2999 },
      front: { name: 'Front Window Shield', amount: 4000 },
      rear: { name: 'Rear Window Shield', amount: 3000 }
    };

    function staticShadeName(shadeKey) {
      return staticShadeDetails[shadeKey] ? staticShadeDetails[shadeKey].name : '';
    }

    function staticShadePrice(shadeKey, qty) {
      var details = staticShadeDetails[shadeKey];
      var total = details ? details.amount * (qty || 1) : 0;
      return 'Rs. ' + total.toLocaleString('en-US');
    }

    var params = new URLSearchParams(window.location.search);
    var brandParam = (params.get('brand') || '').trim().toLowerCase();
    var modelParam = (params.get('model') || '').trim();
    var yearParam = parseInt(params.get('year'), 10) || 0;

    // ------------------------------------------------------------------
    // Name helpers - intentionally mirror shop-by-car-models.liquid so the
    // `model` slug arriving in the URL can be resolved against the exact
    // same cleaned model names that generated it.
    // ------------------------------------------------------------------
    function escapeRegExp(value) {
      return String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function slug(value) {
      return String(value || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    function normalizeRange(value) {
      return String(value || '').replace(/[\u2013\u2014]/g, '-').replace(/\s+/g, ' ').trim();
    }

    function normalizeName(value) {
      return String(value || '').toLowerCase().replace(/\s+/g, ' ').trim();
    }

    var brandPrefixes = {};
    if (brandParam) brandPrefixes[brandParam] = true;

    function cleanModelName(value) {
      var name = String(value || '').replace(/[\u2013\u2014]/g, '-').replace(/\s+/g, ' ').trim();
      name = name.replace(/\s+(?:19|20)\d{2}\s*-\s*(?:19|20)\d{2}$/i, '');
      name = name.replace(/\s+(?:19|20)\d{2}$/i, '');
      if (Object.keys(brandPrefixes).length) {
        var prefixRe = new RegExp('^(?:' + Object.keys(brandPrefixes).map(escapeRegExp).join('|') + ')\\s+', 'i');
        name = name.replace(prefixRe, '');
      }
      return name.replace(/\s+/g, ' ').trim();
    }

    function parseRange(value) {
      var parts = normalizeRange(value).split('-');
      var start = parseInt(parts[0], 10) || 0;
      var end = parseInt(parts[parts.length - 1], 10) || start;
      return { start: start, end: end };
    }

    function readIsland(selector) {
      var node = document.querySelector(selector);
      if (!node) return [];
      try {
        var parsed = JSON.parse(node.textContent);
        return Array.isArray(parsed) ? parsed : [];
      } catch (error) {
        return [];
      }
    }

    var brands = readIsland('[data-car-results-brands]');
    var models = readIsland('[data-car-results-models]');

    // Cached copies of the Shopify product data islands so the submit handler
    // can resolve the live variant id deterministically - even if the async
    // attribute-hydration pass has not run yet (or did not match).
    var compatIslandData = (function () {
      var node = document.querySelector('[data-car-compat-test]');
      if (!node) return {};
      try { return JSON.parse(node.textContent) || {}; } catch (error) { return {}; }
    })();

    var universalIslandData = (function () {
      var node = document.querySelector('[data-car-results-universal]');
      if (!node) return {};
      try { return JSON.parse(node.textContent) || {}; } catch (error) { return {}; }
    })();

    // ------------------------------------------------------------------
    // Resolve the selected car from brand/model/year parameters.
    //
    // shop-by-car-models builds links as:
    //   ?brand=<handle>&model=<slug(cleanModelName(name))>&year=<rangeStart>
    // so here we reconstruct cleanName per record, slug it, and compare -
    // using the same prefix/year stripping and case/space normalisation.
    // ------------------------------------------------------------------
    var brandRecord = null;
    for (var i = 0; i < brands.length; i++) {
      if (String(brands[i].handle || '').toLowerCase() === brandParam) {
        brandRecord = brands[i];
        break;
      }
    }

    if (brandRecord && brandRecord.name) {
      brandPrefixes[String(brandRecord.name).trim().toLowerCase()] = true;
      models.forEach(function (model) { model.cleanName = cleanModelName(model.name); });
    }

    var matchingModels = [];
    if (brandParam) {
      models.forEach(function (model) {
        if (String(model.brand || '').toLowerCase() !== brandParam || !model.cleanName) return;
        if (modelParam && slug(model.cleanName) !== modelParam) return;
        matchingModels.push(model);
      });
    }

    matchingModels.sort(function (a, b) {
      var aRange = parseRange(a.yearRange);
      var bRange = parseRange(b.yearRange);
      if (!yearParam) return bRange.end - aRange.end;
      var aDist = Math.min(Math.abs(aRange.start - yearParam), Math.abs(aRange.end - yearParam));
      var bDist = Math.min(Math.abs(bRange.start - yearParam), Math.abs(bRange.end - yearParam));
      if (aDist !== bDist) return aDist - bDist;
      return normalizeRange(a.yearRange).localeCompare(normalizeRange(b.yearRange));
    });

    var selectedModel = matchingModels[0] || null;

    // ------------------------------------------------------------------
    // Dynamic Full/Half shade cards - driven by the Shopify product
    // metafield custom.compatible_car_models.
    //
    // The store may expose several Full and several Half products, each
    // wired to a different generation range through that metafield. The
    // compatible entry for a shade role is the first candidate product whose
    // referenced car model ids include the resolved selected model id. That
    // entry's image, title, price and description are swapped onto the card
    // from the live Shopify product data. If no candidate references the
    // selected model the static card is left exactly as it is.
    // ------------------------------------------------------------------
    function matchedCompatEntry(shadeKey) {
      if (!compatIslandData || !selectedModel) return null;
      if (selectedModel.id === undefined || selectedModel.id === null) return null;

      var selectedId = String(selectedModel.id);
      var roleData = compatIslandData[shadeKey];
      if (!roleData) return null;

      var candidates = (roleData.candidates && roleData.candidates.length) ? roleData.candidates : [];
      for (var c = 0; c < candidates.length; c++) {
        if ((candidates[c].compatibleModels || []).some(function (ref) {
          return String(ref.id) === selectedId;
        })) {
          return candidates[c];
        }
      }
      return null;
    }

    function renderDynamicShades() {
      ['full', 'half'].forEach(function (shadeKey) {
        var entry = matchedCompatEntry(shadeKey);
        if (!entry) return;

        var button = root.querySelector('[data-shade-key="' + shadeKey + '"]');
        if (!button) return;

        // Record the live entry so the selection handler can reuse it
        // (description + currency-aware price).
        dynamicShades[shadeKey] = entry;

        button.setAttribute('data-shade-name', staticShadeName(shadeKey));
        button.setAttribute('data-shade-price', staticShadePrice(shadeKey, 1));
        if (entry.image) button.setAttribute('data-shade-image', entry.image);
        // Prefer a confirmed buyable variant (scanned from the variant list,
        // then first_available_variant) over the default variant so a
        // sold-out first/default variant never blocks a buyable product.
        var crLiveVariant = entry.buyableVariantId || entry.availableVariantId || entry.variantId;
        if (crLiveVariant) button.setAttribute('data-cr-variant-id', String(crLiveVariant));
        button.setAttribute('data-cr-available', (entry.buyableVariantId || entry.availableVariantId || entry.productAvailable || entry.available) ? 'true' : 'false');

        var thumbImg = button.querySelector('.car-results__shade-thumb img');
        if (thumbImg && entry.image) {
          thumbImg.src = entry.image;
          thumbImg.alt = entry.title || '';
        }
        var nameEl = button.querySelector('.car-results__shade-name');
        if (nameEl) nameEl.textContent = staticShadeName(shadeKey);

        // If this card is the currently selected shade, reflect it in the
        // showcase + summary/pricing column right away.
        if (button.classList.contains('is-active')) {
          if (entry.image && stageImg) {
            stageImg.src = entry.image;
            stageImg.alt = entry.title || '';
          }
          if (shadeName) shadeName.textContent = staticShadeName(shadeKey);
          if (entry.description && shadeDesc) shadeDesc.innerHTML = entry.description;
          var qtyEl = root.querySelector('[data-cr-qty-value]');
          var qty = parseInt(String(qtyEl ? qtyEl.textContent : '1').replace(/[^0-9]/g, ''), 10) || 1;
          if (shadePrice) shadePrice.textContent = staticShadePrice(shadeKey, qty);
        }
      });
    }

    // Run once the rest of this script has queried the DOM references this
    // renderer depends on (stageImg, shadeName, shadePrice, quantity).
    window.setTimeout(renderDynamicShades, 0);

    // ------------------------------------------------------------------
    // Universal Front Windshield Shade / Rear Windshield Shade cards.
    //
    // Unlike Full/Half these two products fit every car, so they are
    // rendered from the data-car-results-universal island without any
    // `Compatible Car Models` matching. Same UI treatment as the dynamic
    // Full/Half cards: image, title, price (and variant id for Add to
    // cart) all come from the live Shopify product records.
    // ------------------------------------------------------------------
    function renderUniversalShades() {
      var universalData = universalIslandData;
      if (!universalData) return;

      ['front', 'rear'].forEach(function (shadeKey) {
        var entry = universalData[shadeKey];
        if (!entry || !entry.found) return;

        var button = root.querySelector('[data-shade-key="' + shadeKey + '"]');
        if (!button) return;

        // Record the live entry so the selection handler can reuse it
        // (description + currency-aware price).
        dynamicShades[shadeKey] = entry;

        button.setAttribute('data-shade-name', staticShadeName(shadeKey));
        button.setAttribute('data-shade-price', staticShadePrice(shadeKey, 1));
        if (entry.image) button.setAttribute('data-shade-image', entry.image);
        // Prefer a confirmed buyable variant (scanned from the variant list,
        // then first_available_variant) over the default variant so a
        // sold-out first/default variant never blocks a buyable product.
        var crLiveVariant = entry.buyableVariantId || entry.availableVariantId || entry.variantId;
        if (crLiveVariant) button.setAttribute('data-cr-variant-id', String(crLiveVariant));
        button.setAttribute('data-cr-available', (entry.buyableVariantId || entry.availableVariantId || entry.productAvailable || entry.available) ? 'true' : 'false');

        var thumbImg = button.querySelector('.car-results__shade-thumb img');
        if (thumbImg && entry.image) {
          thumbImg.src = entry.image;
          thumbImg.alt = entry.title || '';
        }
        var nameEl = button.querySelector('.car-results__shade-name');
        if (nameEl) nameEl.textContent = staticShadeName(shadeKey);

        // If this card is the currently selected shade, reflect it in the
        // showcase + summary/pricing column right away.
        if (button.classList.contains('is-active')) {
          if (entry.image && stageImg) {
            stageImg.src = entry.image;
            stageImg.alt = entry.title || '';
          }
          if (shadeName) shadeName.textContent = staticShadeName(shadeKey);
          if (entry.description && shadeDesc) shadeDesc.innerHTML = entry.description;
          var qtyEl = root.querySelector('[data-cr-qty-value]');
          var qty = parseInt(String(qtyEl ? qtyEl.textContent : '1').replace(/[^0-9]/g, ''), 10) || 1;
          if (shadePrice) shadePrice.textContent = staticShadePrice(shadeKey, qty);
        }
      });
    }

    window.setTimeout(renderUniversalShades, 0);

    // Graceful fallback: if the initially-selected shade (Full) has no
    // hydrated live product - e.g. when the selected car is not listed in
    // the product's Compatible Car Models - populate the showcase with that
    // card's configured placeholder so the stage is never left blank. This
    // runs AFTER both hydration passes, so no default/demo car image can
    // flash before the dynamic data has had its chance to resolve.
    window.setTimeout(function () {
      if (!stageImg || stageImg.getAttribute('src')) return;
      var active = activeShade();
      if (!active) return;
      var fallbackImage = active.getAttribute('data-shade-image');
      if (fallbackImage) {
        stageImg.src = fallbackImage;
        stageImg.alt = active.getAttribute('data-shade-name') || '';
      }
    }, 0);

    function yearsLabel(model) {
      if (!model || !model.yearRange) return '';
      return normalizeRange(model.yearRange).replace('-', ' - ');
    }

    function rangeContainsYear(rangeValue, year) {
      if (!year) return false;
      var range = parseRange(rangeValue);
      if (!range.start) return false;
      return year >= range.start && year <= range.end;
    }

    // ------------------------------------------------------------------
    // Header / identity panel
    // ------------------------------------------------------------------
    var titleBrand = root.querySelector('[data-cr-title-brand]');
    var titleModel = root.querySelector('[data-cr-title-model]');
    var chipYear = root.querySelector('[data-cr-chip-year]');
    var stageImg = root.querySelector('.car-results__stage-img');
    var fullsizeBtn = root.querySelector('[data-cr-fullsize]');

    document.title = 'Car Results';

    if (titleBrand) {
      titleBrand.textContent = brandRecord && brandRecord.name
        ? brandRecord.name
        : titleBrand.textContent;
    }

    if (titleModel) {
      if (selectedModel && selectedModel.cleanName) {
        titleModel.textContent = selectedModel.cleanName;
        titleModel.hidden = false;
      } else if (modelParam) {
        titleModel.textContent = modelParam.replace(/-/g, ' ').replace(/\b\w/g, function (m) { return m.toUpperCase(); });
        titleModel.hidden = false;
      }
    }

    if (chipYear) {
      var chipText = '';
      if (selectedModel) chipText = yearsLabel(selectedModel);
      else if (yearParam) chipText = String(yearParam);
      if (chipText) {
        chipYear.textContent = chipText;
        chipYear.hidden = false;
      }
    }

    // NOTE: the showcase image is intentionally NOT set from the selected
    // car model's metaobject image here. The stage starts empty (no static
    // src) and is populated only when the initially-selected Full Window
    // Coverage product hydrates in renderDynamicShades - this prevents
    // any default/demo car image from flashing on initial page load.

    // ------------------------------------------------------------------
    // Shade selection - swaps the showcase image and updates the summary
    // ------------------------------------------------------------------
    var shadeButtons = Array.prototype.slice.call(root.querySelectorAll('.car-results__shade'));
    var shadeName = root.querySelector('[data-cr-shade-name]');
    var shadePrice = root.querySelector('[data-cr-price]');
    var qtyValue = root.querySelector('[data-cr-qty-value]');
    var minusBtn = root.querySelector('[data-cr-qty-minus]');
    var plusBtn = root.querySelector('[data-cr-qty-plus]');
    var buyForm = root.querySelector('.car-results__buy');
    var addBtn = root.querySelector('[data-cr-add]');
    var shadeDesc = root.querySelector('[data-cr-desc]');
    var defaultShadeDesc = shadeDesc ? shadeDesc.innerHTML : '';
    var quantity = 1;

    // shadeKey -> matched live product entry (full/half)
    var dynamicShades = {};

    // Shade tab UI references - the "side" group tab owns the Full/Half
    // sub-tabs; "rear"/"front" are single-shade tabs.
    var tabButtons = Array.prototype.slice.call(root.querySelectorAll('[data-cr-tab]'));
    var subtabButtons = Array.prototype.slice.call(root.querySelectorAll('[data-cr-subtab]'));
    var subtabsWrap = root.querySelector('[data-cr-subtabs]');

    function moneyParts(money) {
      var s = String(money || '');
      var m = /^([^\d]*)([\d.,]+)(.*)$/.exec(s);
      if (!m) return { prefix: '', amount: 0, suffix: '' };
      return {
        prefix: m[1],
        amount: parseFloat(m[2].replace(/[^0-9.]/g, '')),
        suffix: m[3]
      };
    }

    function formatMoney(money, qty) {
      var p = moneyParts(money);
      var total = p.amount * (qty || 1);
      var num = total.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      return p.prefix + num + p.suffix;
    }

    function activeShade() {
      for (var s = 0; s < shadeButtons.length; s++) {
        if (shadeButtons[s].classList.contains('is-active')) return shadeButtons[s];
      }
      return null;
    }

    function activeShadeMoney() {
      var shade = activeShade();
      return shade ? shade.getAttribute('data-shade-price') || '' : '';
    }

    function refreshTotal() {
      var shade = activeShade();
      if (shadePrice) shadePrice.textContent = staticShadePrice(shade ? shade.getAttribute('data-shade-key') : '', quantity);
    }

    function setQuantity(next) {
      quantity = Math.min(99, Math.max(1, next));
      if (qtyValue) qtyValue.textContent = String(quantity);
      refreshTotal();
    }

    shadeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        shadeButtons.forEach(function (other) {
          var isActive = other === button;
          other.classList.toggle('is-active', isActive);
          other.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        var shadeImage = button.getAttribute('data-shade-image');
        if (shadeImage && stageImg) {
          stageImg.src = shadeImage;
          stageImg.alt = button.getAttribute('data-shade-name') || '';
        }
        if (shadeName) shadeName.textContent = staticShadeName(button.getAttribute('data-shade-key'));

        // Full/Half live products show their Shopify description; all other
        // shades keep the static demo description.
        if (shadeDesc) {
          var dynamicEntry = dynamicShades[button.getAttribute('data-shade-key')];
          shadeDesc.innerHTML = (dynamicEntry && dynamicEntry.description)
            ? dynamicEntry.description
            : defaultShadeDesc;
        }

        reflectTabsForShadeKey(button.getAttribute('data-shade-key'));

        refreshTotal();
      });
    });

    // ------------------------------------------------------------------
    // Shade tab UI - the three category tabs sit directly below the
    // Premium Quality note in the details column and drive the exact same
    // selection path as the rail cards: a tab/sub-tab click re-activates
    // the matching rail shade button (data-shade-key), so the showcase
    // image, title, price, variant id and availability all come from the
    // existing Shopify product data - no separate resolution logic.
    //
    //   "side" (4 side coverage sunshades) owns the two Full/Half
    //   sub-tabs. Rear Window Shield / Front Window Shield are single
    //   shade tabs that hide the Full/Half sub-tabs while they are active.
    // ------------------------------------------------------------------
    function tabButtonByKey(key) {
      for (var t = 0; t < tabButtons.length; t++) {
        if (tabButtons[t].getAttribute('data-cr-tab') === key) return tabButtons[t];
      }
      return null;
    }

    function subtabButtonByKey(key) {
      for (var st = 0; st < subtabButtons.length; st++) {
        if (subtabButtons[st].getAttribute('data-cr-subtab') === key) return subtabButtons[st];
      }
      return null;
    }

    function shadeButtonByKey(key) {
      for (var s = 0; s < shadeButtons.length; s++) {
        if (shadeButtons[s].getAttribute('data-shade-key') === key) return shadeButtons[s];
      }
      return null;
    }

    function setTabActive(key) {
      var active = tabButtonByKey(key);
      tabButtons.forEach(function (tab) {
        var isOn = tab === active;
        tab.classList.toggle('is-active', isOn);
        tab.setAttribute('aria-selected', isOn ? 'true' : 'false');
      });
    }

    function setSubtabActive(key) {
      var active = subtabButtonByKey(key);
      subtabButtons.forEach(function (st) {
        var isOn = st === active;
        st.classList.toggle('is-active', isOn);
        st.setAttribute('aria-selected', isOn ? 'true' : 'false');
      });
    }

    // Keep the tab/sub-tab UI in sync with whichever shade is selected.
    function reflectTabsForShadeKey(key) {
      if (key === 'full' || key === 'half') {
        setTabActive('side');
        setSubtabActive(key);
        if (subtabsWrap) subtabsWrap.hidden = false;
      } else if (key === 'rear' || key === 'front') {
        setTabActive(key);
        if (subtabsWrap) subtabsWrap.hidden = true;
      }
    }

    function activeSubtabKey() {
      var fallback = 'full';
      for (var st = 0; st < subtabButtons.length; st++) {
        if (subtabButtons[st].classList.contains('is-active')) {
          fallback = subtabButtons[st].getAttribute('data-cr-subtab') || fallback;
        }
      }
      return fallback;
    }

    tabButtons.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var tabKey = tab.getAttribute('data-cr-tab');
        var shadeBtn = shadeButtonByKey(tabKey);
        if (tabKey === 'side') {
          // Re-show the Full/Half sub-tabs. If a Rear/Front shade was
          // active (sub-tabs hidden) fall back to the default FULL sub-tab;
          // otherwise keep the currently active Full/Half selection.
          if (subtabsWrap && subtabsWrap.hidden) {
            setSubtabActive('full');
            shadeBtn = shadeButtonByKey('full');
          } else {
            shadeBtn = shadeButtonByKey(activeSubtabKey());
          }
        }
        if (shadeBtn) shadeBtn.click();
      });
    });

    subtabButtons.forEach(function (st) {
      st.addEventListener('click', function () {
        var shadeBtn = shadeButtonByKey(st.getAttribute('data-cr-subtab'));
        if (shadeBtn) shadeBtn.click();
      });
    });

    if (minusBtn) minusBtn.addEventListener('click', function () { setQuantity(quantity - 1); });
    if (plusBtn) plusBtn.addEventListener('click', function () { setQuantity(quantity + 1); });

    // View full size - opens the current showcase image in a new tab.
    if (fullsizeBtn && stageImg) {
      fullsizeBtn.addEventListener('click', function () {
        var url = stageImg.currentSrc || stageImg.src;
        if (url) window.open(url, '_blank', 'noopener');
      });
    }

    // ------------------------------------------------------------------
    // Selected-car line item properties. The car is already resolved above
    // (selectedModel / brandRecord - the exact data the Car Results page
    // displays), so it is attached to the cart line at add-to-cart time.
    // Underscore-prefixed keys stay hidden from Shopify checkout/emails
    // while remaining readable from /cart.js - the drawer renders them
    // cleanly. No car data is hardcoded and the drawer never re-resolves
    // the model from the URL.
    // ------------------------------------------------------------------
    function buildCarLineProperties() {
      var props = {};
      if (!selectedModel) return props;
      var brandName = brandRecord && brandRecord.name ? String(brandRecord.name).trim() : '';
      var modelName = selectedModel.cleanName || selectedModel.name || '';
      var years = selectedModel.yearRange
        ? normalizeRange(selectedModel.yearRange).replace('-', '\u2013')
        : '';
      if (brandName) props._car_brand = brandName;
      if (modelName) props._car_model = modelName;
      if (years) props._car_years = years;
      if (selectedModel.handle) props._car_model_handle = String(selectedModel.handle);
      return props;
    }

    // Add to cart - posts the selected shade's live variant to /cart/add.js
    // using its real variant id and quantity, then opens the cart drawer to
    // show the actual Shopify cart. All product data (variant id, price,
    // image, title) comes from the live Shopify product records hydrated
    // onto the shade buttons - nothing is hardcoded and no fake "Added"
    // feedback is shown.
    if (buyForm) {
      buyForm.addEventListener('submit', function (event) {
        event.preventDefault();
        if (!addBtn || addBtn.disabled) return;

        var active = activeShade();
        var key = active ? (active.getAttribute('data-shade-key') || '') : '';

        if (!active || !key) {
          console.error('ADD TO CART: no active shade found', { active: active, shadeButtons: shadeButtons.length });
          return;
        }

        // Live variant id - prefer the attribute hydrated by the async
        // renderers, then fall back to the same Shopify data islands so the
        // value resolves deterministically for every card.
        var variantId = active.getAttribute('data-cr-variant-id') || '';
        var availableAttr = active.getAttribute('data-cr-available');
        var islandEntry = null;

        if (key === 'full' || key === 'half') {
          islandEntry = matchedCompatEntry(key);
        } else if (key === 'front' || key === 'rear') {
          islandEntry = (universalIslandData && universalIslandData[key]) || null;
        }

        // The islands flag the variants Shopify confirms as buyable for the
        // product: `buyableVariantId` is scanned straight from the variant
        // list (first variant with available == true) and
        // `availableVariantId` is the product's first_available_variant.
        // Prefer a confirmed buyable variant over the default variant so a
        // sold-out first/default variant never blocks a genuinely-buyable
        // product. When no buyable variant exists the availability gate
        // below keeps rejecting - nothing is force-added.
        var buyableVariant = islandEntry ? String(islandEntry.buyableVariantId || islandEntry.availableVariantId || '') : '';
        if (!variantId) {
          variantId = String(buyableVariant || (islandEntry && islandEntry.variantId) || '');
        }

        var isAvailable = Boolean(buyableVariant) ||
          ((availableAttr === null || availableAttr === undefined || availableAttr === '')
            ? (islandEntry ? islandEntry.available !== false : true)
            : availableAttr !== 'false');

        console.debug('[Car Results] Add to cart trace', {
          shadeKey: key,
          shadeName: active.getAttribute('data-shade-name'),
          activeClass: active.className,
          ariaPressed: active.getAttribute('aria-pressed'),
          variantAttr: active.getAttribute('data-cr-variant-id'),
          availableAttr: availableAttr,
          islandVariantId: islandEntry ? islandEntry.variantId : null,
          resolvedVariantId: variantId || null,
          quantity: quantity
        });

        if (!variantId) {
          console.error('ADD TO CART: missing variant ID', {
            shadeKey: key,
            shadeName: active.getAttribute('data-shade-name'),
            shadeImage: active.getAttribute('data-shade-image'),
            shadePrice: active.getAttribute('data-shade-price'),
            variantAttr: active.getAttribute('data-cr-variant-id'),
            availableAttr: availableAttr,
            islandEntry: islandEntry,
            compatIslandPresent: !!document.querySelector('[data-car-compat-test]'),
            universalIslandPresent: !!document.querySelector('[data-car-results-universal]')
          });
          return;
        }

        if (!isAvailable) {
          console.error('ADD TO CART: selected variant is not available', {
            shadeKey: key,
            variantId: variantId,
            availableAttr: availableAttr,
            islandAvailable: islandEntry ? islandEntry.available : null
          });
          return;
        }

        addBtn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            items: [{
              id: parseInt(variantId, 10),
              quantity: quantity,
              properties: buildCarLineProperties()
            }]
          })
        })
          .then(function (response) {
            if (!response.ok) throw new Error('Add to cart failed: ' + response.status);
            return response.json();
          })
          .then(function (cart) {
            console.debug('[Car Results] Add to cart success', {
              shadeKey: key,
              variantId: variantId,
              quantity: quantity,
              cartItemCount: cart.item_count,
              cartTotalPrice: cart.total_price
            });

            // Re-enable so repeated adds keep working (fixes a stuck-disabled
            // button after the first successful add).
            addBtn.disabled = false;

            // Open the existing cart drawer; it re-fetches /cart.js so the
            // newly added item and the real cart totals are displayed.
            if (window.AutoDrapeCart) {
              if (window.AutoDrapeCart.refresh) window.AutoDrapeCart.refresh();
              if (window.AutoDrapeCart.open) window.AutoDrapeCart.open();
            } else {
              console.error('ADD TO CART: cart drawer (window.AutoDrapeCart) not found - navigating to /cart instead');
              window.location.href = '/cart';
            }
          })
          .catch(function (error) {
            console.error('ADD TO CART: /cart/add.js request failed', {
              shadeKey: key,
              variantId: variantId,
              quantity: quantity,
              error: error
            });
            addBtn.disabled = false;
          });
      });
    }

    refreshTotal();
  })();
{% endjavascript %}

