{% doc %}
  Renders the Car Results experience for `/pages/car-results`.

  The customer's selection is carried in the URL query string by the car
  selector (`autodrape-car-selector`) and the model directory
  (`shop-by-car-models`) snippets:

      /pages/car-results?brand=bmw&model=x5&year=2019

  This snippet resolves the matching `car_model` metaobject record on the
  client (display name, generation ranges, showcase image) using the same
  data sources and slug helpers as `shop-by-car-models.liquid`, then renders
  a premium shade configurator. Selecting a shade type swaps the showcase
  image and updates the order summary panel. The details column also exposes a
  three-tab shade picker (4 Side Coverage / Rear Window Shield / Front Window
  Shield) with Full/Half sub-tabs; every tab reuses the same shade selection and
  Shopify product-resolution data as the rail cards - no separate resolution.

  Product wiring: Full/Half coverage cards resolve the compatible Shopify
  product through the existing `Compatible Car Models` metafield; Front
  Windshield Shade and Rear Windshield Shade cards resolve their universal
  Shopify products for every vehicle. Titles, prices and variants come
  live from those product records.

  Routing contract: the `brand`/`model`/`year` parameters are consumed here
  only for display and image resolution - they are never rewritten,
  redirected or removed, so existing deep links keep working.

  Full/Half wiring is data driven: every product carrying a non-empty
  `custom.compatible_car_models` metafield is serialised into the
  `data-car-compat-test` island; on the client the Full and Half shade cards
  resolve the product (per role) whose references include the selected car
  model's metaobject id - so additional generations or products require no
  template changes.

  @example
  {% render 'car-results-content' %}
{% enddoc %}
{% render 'vehicle-heading-font' %}


<div class="car-results">
  <div class="car-results__container">

    <div class="car-results__grid">

      <!-- Gallery: showcase stage + shade type selector -->
      <div class="car-results__gallery">

        <figure class="car-results__stage">
          {% comment %}
            The showcase intentionally starts WITHOUT a static image src so no
            default/demo car picture can flash during initial page load. The
            width/height attributes keep the box's aspect ratio (no layout
            shift) while the stage shows only its neutral background until the
            initially-selected Full Window Coverage product hydrates the image.
          {% endcomment %}
          <img class="car-results__stage-img" alt="" width="1200" height="900">
          <button type="button" class="car-results__fullsize" data-cr-fullsize>
            &#8599;&nbsp;{{ 'car_results.view_full_size' | t }}
          </button>
        </figure>

        <p class="car-results__rail-heading">{{ 'car_results.shades_heading' | t }}</p>

        {% comment %}
          Demo shade cards (name + showcase image source). Replace asset
          placeholders and DEMO PRICE values when product wiring becomes
          available. Card price was intentionally dropped so each card stays
          a clean image + name thumbnail; the price lives in the order panel.
        {% endcomment %}
        <div class="car-results__rail" role="group" aria-label="{{ 'car_results.shades_heading' | t }}">

          <button type="button" class="car-results__shade is-active" aria-pressed="true"
            data-shade-key="full"
            data-shade-name="4-Side Shades (Full Window / Half Window)"
            data-shade-price="Rs. 2,999"
            data-shade-image="{{ 'shade-placeholder-full.svg' | asset_url }}">
            <span class="car-results__shade-thumb">
              <img src="{{ 'shade-placeholder-full.svg' | asset_url }}" alt="" loading="lazy" width="128" height="96">
            </span>
            <span class="car-results__shade-name">4-Side Shades (Full Window / Half Window)</span>
          </button>

          <button type="button" class="car-results__shade" aria-pressed="false"
            data-shade-key="half"
            data-shade-name="4-Side Shades (Full Window / Half Window)"
            data-shade-price="Rs. 2,999"
            data-shade-image="{{ 'shade-placeholder-half.svg' | asset_url }}">
            <span class="car-results__shade-thumb">
              <img src="{{ 'shade-placeholder-half.svg' | asset_url }}" alt="" loading="lazy" width="128" height="96">
            </span>
            <span class="car-results__shade-name">4-Side Shades (Full Window / Half Window)</span>
          </button>

          <button type="button" class="car-results__shade" aria-pressed="false"
            data-shade-key="front"
            data-shade-name="Front Window Shield"
            data-shade-price="Rs. 4,000"
            data-shade-image="{{ 'shade-placeholder-windshield.svg' | asset_url }}">
            <span class="car-results__shade-thumb">
              <img src="{{ 'shade-placeholder-windshield.svg' | asset_url }}" alt="" loading="lazy" width="128" height="96">
            </span>
            <span class="car-results__shade-name">Front Window Shield</span>
          </button>

          <button type="button" class="car-results__shade" aria-pressed="false"
            data-shade-key="rear"
            data-shade-name="Rear Window Shield"
            data-shade-price="Rs. 3,000"
            data-shade-image="{{ 'shade-placeholder-windshield.svg' | asset_url }}">
            <span class="car-results__shade-thumb">
              <img src="{{ 'shade-placeholder-windshield.svg' | asset_url }}" alt="" loading="lazy" width="128" height="96">
            </span>
            <span class="car-results__shade-name">Rear Window Shield</span>
          </button>

        </div><!-- /.car-results__rail -->

      </div><!-- /.car-results__gallery -->

      <!-- Details: selected car identity + shade order summary -->
      <aside class="car-results__details">

        <p class="car-results__eyebrow">{{ 'car_results.eyebrow_selected_car' | t }}</p>

        <p class="car-results__brand" data-cr-title-brand>{{ 'car_results.heading_fallback' | t }}</p>
        <h1 class="car-results__model" data-cr-title-model hidden></h1>

        <p class="car-results__year" data-cr-chip-year hidden></p>

        <hr class="car-results__rule">

        <p class="car-results__shade-label">{{ 'car_results.selected_shade_label' | t }}</p>
        <h2 class="car-results__shade-heading" data-cr-shade-name>4-Side Shades (Full Window / Half Window)</h2>

        <p class="car-results__desc" data-cr-desc>{{ 'car_results.shade_desc_full' | t }}</p>

        <div class="car-results__quality">
          <p class="car-results__quality-label">{{ 'car_results.quality_label' | t }}</p>
          <p class="car-results__quality-text">{{ 'car_results.quality_text' | t }}</p>
        </div>

        <div class="car-results__tabs" data-cr-tabs>
          <div class="car-results__tabs-row" role="tablist" aria-label="{{ 'car_results.tabs_label' | t }}">
            <button type="button" class="car-results__tab is-active" role="tab" aria-selected="true"
              data-cr-tab="side">{{ 'car_results.tab_side_name' | t }}</button>
            <button type="button" class="car-results__tab" role="tab" aria-selected="false"
              data-cr-tab="rear">{{ 'car_results.tab_rear_name' | t }}</button>
            <button type="button" class="car-results__tab" role="tab" aria-selected="false"
              data-cr-tab="front">{{ 'car_results.tab_front_name' | t }}</button>
          </div>

          <div class="car-results__subtabs" role="tablist" aria-label="{{ 'car_results.shades_heading' | t }}" data-cr-subtabs>
            <button type="button" class="car-results__subtab is-active" role="tab" aria-selected="true"
              data-cr-subtab="full">{{ 'car_results.subtab_full_name' | t }}</button>
            <button type="button" class="car-results__subtab" role="tab" aria-selected="false"
              data-cr-subtab="half">{{ 'car_results.subtab_half_name' | t }}</button>
          </div>
        </div>

        <form class="car-results__buy" action="#" novalidate>
          <div class="car-results__qty">
            <button type="button" class="car-results__qty-btn" data-cr-qty-minus aria-label="{{ 'car_results.decrease_qty_aria' | t }}">&minus;</button>
            <output class="car-results__qty-value" data-cr-qty-value aria-live="polite">1</output>
            <button type="button" class="car-results__qty-btn" data-cr-qty-plus aria-label="{{ 'car_results.increase_qty_aria' | t }}">+</button>
          </div>
          <span class="car-results__price" data-cr-price>Rs. 2,999</span>
          <button type="submit" class="car-results__add" data-cr-add>{{ 'car_results.add_to_cart' | t }}</button>
        </form>

        <p class="car-results__secure">{{ 'car_results.secure_note' | t }}</p>

      </aside>

    </div><!-- /.car-results__grid -->

    {% comment %}
      Client-side resolution data - mirrors the metaobject sources of
      shop-by-car-models.liquid so name slugs and generation images stay in
      perfect sync across the flow.
    {% endcomment %}

    <script type="application/json" data-car-results-brands>
      [
        {% for brand in metaobjects.car_brand.values %}
          {
            "handle": {{ brand.system.handle | handleize | json }},
            "name": {{ brand.brand_name.value | default: brand.title | json }},
            "logo": {% if brand.brand_logo.value %}{{ brand.brand_logo.value | image_url: width: 400 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

    <script type="application/json" data-car-results-models>
      [
        {% paginate metaobjects.car_model.values by 250 %}
        {% for cr_model in metaobjects.car_model.values %}
          {% assign cr_model_brand = cr_model.brand.value %}
          {% assign cr_model_image = cr_model.image.value | default: cr_model.model_image.value %}
          {
            "id": {{ cr_model.system.id | json }},
            "handle": {{ cr_model.system.handle | json }},
            "name": {{ cr_model.model_name.value | default: cr_model.model_name | json }},
            "yearRange": {{ cr_model.year_range.value | default: cr_model.year_range | json }},
            "brand": {% if cr_model_brand %}{{ cr_model_brand.system.handle | handleize | json }}{% else %}null{% endif %},
            "image": {% if cr_model_image %}{{ cr_model_image | image_url: width: 1100 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
        {% endpaginate %}
      ]
    </script>

    {% comment %}
      Full/Half compatible product wiring - fully data driven, nothing pinned.

      A car is compatible with a shade when the product's
      `custom.compatible_car_models` metafield references the selected
      `car_model` metaobject. The store keeps multiple "Full Window Coverage
      Sunshades" / "Half Window Coverage Sunshades" products, each wired to a
      different generation range through that metafield. Every product that
      carries at least one compatible-car reference is collected below and
      serialised into the `data-car-compat-test` island; the client then
      picks - per shade role (full/half, detected from the product's Shade Type metafield) -
      the product whose references include the resolved selected model. The
      chosen product's live title, price, image, description and variant are
      what its card shows. If no candidate references the selected model the
      static card stays exactly as it is.
    {% endcomment %}

    {% assign compat_full_entry_json = '' %}
    {% assign compat_half_entry_json = '' %}

    {% comment %}
      Candidate product data is captured straight from the scan iteration
      below (the product object is already in scope there), because the
      previous island re-looked every candidate up via `all_products[handle]`
      and Shopify caps that object at 20 unique handles per page - once ~20
      compatible products were active the lookups that ran last (the half
      list, serialized after full) silently returned empty and those
      candidates vanished from `data-car-compat-test`. Collection iteration
      is not subject to that limit. Fragments are joined with commas only
      between successfully captured entries, so the island JSON stays valid.
    {% endcomment %}

    {% paginate collections.all.products by 250 %}
      {% for compat_candidate in collections.all.products %}
        {% assign compat_candidate_refs = null %}
        {% if compat_candidate.metafields.custom.compatible_car_models %}
          {% assign compat_candidate_refs = compat_candidate.metafields.custom.compatible_car_models.value %}
          {% unless compat_candidate_refs %}
            {% assign compat_candidate_refs = compat_candidate.metafields.custom.compatible_car_models.references %}
          {% endunless %}
        {% endif %}

        {% if compat_candidate_refs %}
          {% assign compat_candidate_shade_type = compat_candidate.metafields.custom.shade_type.value | strip | downcase %}
          {% assign compat_entry_role = 'none' %}
          {% if compat_candidate_shade_type contains 'full window' %}
            {% assign compat_entry_role = 'full' %}
          {% elsif compat_candidate_shade_type contains 'half window' %}
            {% assign compat_entry_role = 'half' %}
          {% endif %}
          {% unless compat_entry_role == 'none' %}
            {% assign compat_candidate_feat_url = compat_candidate.featured_image | image_url: width: 1100 %}
            {% assign compat_candidate_image = '' %}
            {% for compat_img in compat_candidate.images %}
              {% if compat_candidate_image == '' %}
                {% assign compat_img_url = compat_img | image_url: width: 1100 %}
                {% if compat_img_url != compat_candidate_feat_url %}{% assign compat_candidate_image = compat_img_url %}{% endif %}
              {% endif %}
            {% endfor %}
            {% if compat_candidate_image == '' %}{% assign compat_candidate_image = compat_candidate_feat_url %}{% endif %}
            {% assign compat_candidate_variant = compat_candidate.selected_or_first_available_variant %}
            {% assign compat_candidate_available_variant = compat_candidate.first_available_variant %}
            {% assign compat_candidate_buyable_variant_id = null %}
            {% for compat_candidate_variant_option in compat_candidate.variants limit: 50 %}
              {% if compat_candidate_variant_option.available %}
                {% assign compat_candidate_buyable_variant_id = compat_candidate_variant_option.id %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% capture compat_entry_json %}{"title": {{ compat_candidate.title | json }},"handle": {{ compat_candidate.handle | json }},"price": {{ compat_candidate.price | money | json }},"description": {{ compat_candidate.description | json }},"image": {% if compat_candidate_image %}{{ compat_candidate_image | json }}{% else %}null{% endif %},"variantId": {% if compat_candidate_variant %}{{ compat_candidate_variant.id | json }}{% else %}null{% endif %},"buyableVariantId": {% if compat_candidate_buyable_variant_id %}{{ compat_candidate_buyable_variant_id | json }}{% else %}null{% endif %},"productAvailable": {{ compat_candidate.available | json }},"availableVariantId": {% if compat_candidate_available_variant %}{{ compat_candidate_available_variant.id | json }}{% else %}null{% endif %},"available": {% if compat_candidate_variant %}{{ compat_candidate_variant.available | json }}{% else %}null{% endif %},"compatibleModels": [{% for compat_ref in compat_candidate_refs %}{"id": {{ compat_ref.system.id | json }},"handle": {{ compat_ref.system.handle | json }},"name": {{ compat_ref.model_name.value | default: compat_ref.model_name | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% endcapture %}
            {% if compat_entry_role == 'full' %}
              {% if compat_full_entry_json != '' %}{% assign compat_full_entry_json = compat_full_entry_json | append: ',' %}{% endif %}
              {% assign compat_full_entry_json = compat_full_entry_json | append: compat_entry_json %}
            {% else %}
              {% if compat_half_entry_json != '' %}{% assign compat_half_entry_json = compat_half_entry_json | append: ',' %}{% endif %}
              {% assign compat_half_entry_json = compat_half_entry_json | append: compat_entry_json %}
            {% endif %}
          {% endunless %}
        {% endif %}
      {% endfor %}
    {% endpaginate %}

    {% comment %}
      UNIVERSAL FRONT/REAR PRODUCTS - dynamic for every selected car.

      Front Windshield Shade and Rear Windshield Shade apply regardless of the
      selected vehicle, so unlike Full/Half there is no `Compatible Car
      Models` matching.

      Front resolves by handle (`all_products['front-windshield-shade']`)
      with a title-scan fallback over collections.all.

      Rear resolves by its EXACT title "Rear Windshield Shade" across the
      whole catalog (paginated) - no handle is guessed, and the old general
      "Rear Window Shield" product can never be matched because its title
      differs.
    {% endcomment %}

    {% assign universal_front_product = all_products['front-windshield-shade'] %}
    {% assign universal_rear_product = null %}
    {% assign universal_front_found = false %}
    {% assign universal_rear_found = false %}

    {% if universal_front_product %}
      {% assign universal_front_found = true %}
    {% endif %}
    {% if universal_rear_product %}
      {% assign universal_rear_found = true %}
    {% endif %}

    {% unless universal_front_found %}
      {% for universal_candidate in collections.all.products %}
        {% unless universal_front_found %}
          {% assign universal_candidate_title = universal_candidate.title | downcase %}
          {% if universal_candidate_title contains 'front windshield' %}
            {% assign universal_front_product = universal_candidate %}
            {% assign universal_front_found = true %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    {% endunless %}

    {% comment %}
      Exact-title resolution for the Rear Windshield Shade product. Search
      spans the whole catalog via pagination (beyond the default 50-product
      window) and matches the product whose trimmed, lowercased title is
      exactly "rear windshield shade" - no handle is guessed and the old
      general "Rear Window Shield" product is never selected.
    {% endcomment %}
    {% paginate collections.all.products by 250 %}
      {% for universal_candidate in collections.all.products %}
        {% assign universal_candidate_title = universal_candidate.title | strip | downcase %}
        {% if universal_candidate_title == 'rear windshield shade' %}
          {% assign universal_rear_product = universal_candidate %}
        {% endif %}
      {% endfor %}
    {% endpaginate %}

    {% if universal_rear_product %}
      {% assign universal_rear_found = true %}
    {% endif %}

    {% assign universal_front_image = '' %}
    {% if universal_front_found %}
      {% assign universal_front_image = universal_front_product.featured_image | image_url: width: 1100 %}
      {% if universal_front_image == '' %}
        {% assign universal_front_image = universal_front_product.images.first | image_url: width: 1100 %}
      {% endif %}
    {% endif %}

    {% assign universal_rear_image = '' %}
    {% if universal_rear_found %}
      {% assign universal_rear_image = universal_rear_product.featured_image | image_url: width: 1100 %}
      {% if universal_rear_image == '' %}
        {% assign universal_rear_image = universal_rear_product.images.first | image_url: width: 1100 %}
      {% endif %}
    {% endif %}

    {% assign universal_front_variant = null %}
    {% assign universal_front_buyable_variant_id = null %}
    {% if universal_front_found %}
      {% assign universal_front_variant = universal_front_product.selected_or_first_available_variant %}
      {% assign universal_front_available_variant = universal_front_product.first_available_variant %}
      {% for universal_front_variant_option in universal_front_product.variants limit: 50 %}
        {% if universal_front_variant_option.available %}
          {% assign universal_front_buyable_variant_id = universal_front_variant_option.id %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% assign universal_rear_variant = null %}
    {% assign universal_rear_buyable_variant_id = null %}
    {% if universal_rear_found %}
      {% assign universal_rear_variant = universal_rear_product.selected_or_first_available_variant %}
      {% assign universal_rear_available_variant = universal_rear_product.first_available_variant %}
      {% for universal_rear_variant_option in universal_rear_product.variants limit: 50 %}
        {% if universal_rear_variant_option.available %}
          {% assign universal_rear_buyable_variant_id = universal_rear_variant_option.id %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    <script type="application/json" data-car-compat-test>
      {
        "full": {
          "found": {% if compat_full_entry_json != '' %}true{% else %}false{% endif %},
          "candidates": [{{ compat_full_entry_json }}]
        },
        "half": {
          "found": {% if compat_half_entry_json != '' %}true{% else %}false{% endif %},
          "candidates": [{{ compat_half_entry_json }}]
        }
      }
    </script>

    {% comment %}
      UNIVERSAL FRONT/REAR PRODUCT DATA - live Shopify records used to
      hydrate the Front Windshield Shade and Rear Windshield Shade cards for
      every selected car. Title, price, image, description and the Add to
      cart variant id all come from the product records at render time.
    {% endcomment %}

    <script type="application/json" data-car-results-universal>
      {
        "front": {
          "found": {{ universal_front_found | json }},
          "title": {% if universal_front_found %}{{ universal_front_product.title | json }}{% else %}null{% endif %},
          "handle": {% if universal_front_found %}{{ universal_front_product.handle | json }}{% else %}null{% endif %},
          "price": {% if universal_front_found %}{{ universal_front_product.price | money | json }}{% else %}null{% endif %},
          "description": {% if universal_front_found %}{{ universal_front_product.description | json }}{% else %}null{% endif %},
          "image": {% if universal_front_image %}{{ universal_front_image | json }}{% else %}null{% endif %},
          "availableVariantId": {% if universal_front_available_variant %}{{ universal_front_available_variant.id | json }}{% else %}null{% endif %},
          "buyableVariantId": {% if universal_front_buyable_variant_id %}{{ universal_front_buyable_variant_id | json }}{% else %}null{% endif %},
          "productAvailable": {% if universal_front_found %}{{ universal_front_product.available | json }}{% else %}null{% endif %},
          "variantId": {% if universal_front_variant %}{{ universal_front_variant.id | json }}{% else %}null{% endif %},
          "available": {% if universal_front_variant %}{{ universal_front_variant.available | json }}{% else %}null{% endif %}
        },
        "rear": {
          "found": {{ universal_rear_found | json }},
          "title": {% if universal_rear_found %}{{ universal_rear_product.title | json }}{% else %}null{% endif %},
          "handle": {% if universal_rear_found %}{{ universal_rear_product.handle | json }}{% else %}null{% endif %},
          "price": {% if universal_rear_found %}{{ universal_rear_product.price | money | json }}{% else %}null{% endif %},
          "description": {% if universal_rear_found %}{{ universal_rear_product.description | json }}{% else %}null{% endif %},
          "image": {% if universal_rear_image %}{{ universal_rear_image | json }}{% else %}null{% endif %},
          "availableVariantId": {% if universal_rear_available_variant %}{{ universal_rear_available_variant.id | json }}{% else %}null{% endif %},
          "buyableVariantId": {% if universal_rear_buyable_variant_id %}{{ universal_rear_buyable_variant_id | json }}{% else %}null{% endif %},
          "productAvailable": {% if universal_rear_found %}{{ universal_rear_product.available | json }}{% else %}null{% endif %},
          "variantId": {% if universal_rear_variant %}{{ universal_rear_variant.id | json }}{% else %}null{% endif %},
          "available": {% if universal_rear_variant %}{{ universal_rear_variant.available | json }}{% else %}null{% endif %}
        }
      }
    </script>

  </div><!-- /.car-results__container -->
</div><!-- /.car-results -->

{% stylesheet %}
  .car-results {
    width: 100%;
    padding: clamp(24px, 4vw, 56px) clamp(16px, 4vw, 48px) clamp(48px, 6vw, 88px);
    background: #ffffff;
    color: var(--ad-text, #141414);
  }

  .car-results__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .car-results__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 3vw, 44px);
  }

  @media screen and (min-width: 990px) {
    .car-results__grid {
      grid-template-columns: minmax(0, 6.5fr) minmax(380px, 4.5fr);
      align-items: start;
    }
  }

  /* Showcase stage */
  .car-results__stage {
    position: relative;
    overflow: hidden;
    margin: 0;
    border-radius: calc(var(--ad-radius-lg, 20px));
    border: 1px solid var(--ad-border, #e9e2d8);
    background: #ffffff;
    box-shadow: var(--ad-shadow-soft, 0 22px 50px -30px rgba(20, 20, 20, 0.35));
  }

  .car-results__stage-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .car-results__fullsize {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border: 1px solid #e8e2d8;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ad-text, #141414);
    font-family: var(--font-ui--family), system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 6px 18px -8px rgba(20, 20, 20, 0.28);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .car-results__fullsize:hover {
    color: var(--ad-accent, #d90000);
    border-color: rgba(217, 0, 0, 0.4);
  }

  /* Shade type rail heading + cards */
  .car-results__rail-heading {
    margin: 18px 0 12px;
    font-family: var(--font-ui--family), system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
