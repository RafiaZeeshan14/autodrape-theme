<div class="autodrape-car-selector">

  <!-- STEP HEADER -->
  <div class="autodrape-car-selector__steps">

    <div class="autodrape-car-selector__step is-active">
      <span class="autodrape-car-selector__number">1</span>
      <span>Select Brand</span>
    </div>

    <div class="autodrape-car-selector__divider"></div>

    <div class="autodrape-car-selector__step">
      <span class="autodrape-car-selector__number">2</span>
      <span>Select Model</span>
    </div>

    <div class="autodrape-car-selector__divider"></div>

    <div class="autodrape-car-selector__step">
      <span class="autodrape-car-selector__number">3</span>
      <span>Select Year</span>
    </div>

  </div>


  <!-- SELECT FIELDS -->
  <div class="autodrape-car-selector__fields">

    <!-- BRAND -->
    <div class="autodrape-car-selector__field">

      <label for="autodrape-brand">
        Select Brand
      </label>

      <div class="autodrape-car-selector__select-wrap">

        <select id="autodrape-brand" name="brand">
          <option value="">Select Brand</option>

          {% assign car_brands = metaobjects.car_brand.values %}

          {% for brand in car_brands %}
            {% if brand.brand_name.value != blank %}
              <option
                value="{{ brand.system.handle }}"
                data-brand-id="{{ brand.system.id }}"
              >
                {{ brand.brand_name.value }}
              </option>
            {% endif %}
          {% endfor %}

        </select>

        <span class="autodrape-car-selector__arrow">
          <svg viewBox="0 0 24 24">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </span>

      </div>

    </div>


    <!-- MODEL -->
    <div class="autodrape-car-selector__field">

      <label for="autodrape-model">
        Select Model
      </label>

      <div class="autodrape-car-selector__select-wrap">

        <select id="autodrape-model" name="model" disabled>
          <option value="">Select Model</option>
        </select>

        <span class="autodrape-car-selector__arrow">
          <svg viewBox="0 0 24 24">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </span>

      </div>

    </div>


    <!-- YEAR -->
    <div class="autodrape-car-selector__field">

      <label for="autodrape-year">
        Select Year
      </label>

      <div class="autodrape-car-selector__select-wrap">

        <select id="autodrape-year" name="year" disabled>
          <option value="">Select Year</option>
        </select>

        <span class="autodrape-car-selector__arrow">
          <svg viewBox="0 0 24 24">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </span>

      </div>

    </div>

  </div>


  <!-- FIND BUTTON -->
  <button
    type="button"
    class="autodrape-car-selector__button"
    id="autodrape-find-products"
  >
    FIND PRODUCTS
  </button>

</div>


<style>

  .autodrape-car-selector {
    position: relative;
    width: 100%;
    max-width: 1000px;

    padding: 28px 30px 28px;

    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 16px;

    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.12),
      0 4px 12px rgba(0, 0, 0, 0.05);

    backdrop-filter: blur(10px);

    font-family: var(--font-ui--family);
    box-sizing: border-box;
  }


  /* STEP HEADER */

  .autodrape-car-selector__steps {
    display: flex;
    align-items: center;
    justify-content: flex-start;

    gap: 12px;
    margin-bottom: 24px;
  }


  .autodrape-car-selector__step {
    display: flex;
    align-items: center;
    gap: 7px;

    color: #888;

    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;
    white-space: nowrap;
  }


  .autodrape-car-selector__step.is-active {
    color: #d90000;
  }


  .autodrape-car-selector__number {
    width: 28px;
    height: 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #dedede;
    color: #666;

    font-size: 12px;
    font-weight: 800;
  }


  .autodrape-car-selector__step.is-active
  .autodrape-car-selector__number {
    background: #d90000;
    color: #fff;
  }


  .autodrape-car-selector__divider {
    flex: 0 1 38px;
    height: 1px;

    margin: 0 3px;

    background: #e5e5e5;
  }


  /* FIELDS */

  .autodrape-car-selector__fields {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }


  .autodrape-car-selector__field {
    min-width: 0;
  }


  .autodrape-car-selector__field label {
    display: block;

    margin-bottom: 8px;

    color: #666;

    font-size: 13px;
    font-weight: 600;
  }


  .autodrape-car-selector__select-wrap {
    position: relative;
  }


  .autodrape-car-selector__select-wrap select {
    width: 100%;
    height: 62px;

    padding: 0 42px 0 16px;

    appearance: none;

    border: 1px solid #dedede;
    border-radius: 9px;

    background: #fff;
    color: #222;

    font-family: var(--font-ui--family);
    font-size: 15px;
    font-weight: 500;

    outline: none;
    cursor: pointer;

    transition:
      border-color .2s ease,
      box-shadow .2s ease;
  }


  .autodrape-car-selector__select-wrap select:hover {
    border-color: #b7b7b7;
  }


  .autodrape-car-selector__select-wrap select:focus {
    border-color: #a50000;

    box-shadow:
      0 0 0 3px rgba(165, 0, 0, 0.08);
  }


  .autodrape-car-selector__select-wrap select:disabled {
    background: #f7f7f7;
    color: #999;
    cursor: not-allowed;
  }


  .autodrape-car-selector__arrow {
    position: absolute;

    top: 50%;
    right: 15px;

    transform: translateY(-50%);

    pointer-events: none;
  }


  .autodrape-car-selector__arrow svg {
    width: 17px;
    height: 17px;

    fill: none;
    stroke: #555;
    stroke-width: 2;

    stroke-linecap: round;
    stroke-linejoin: round;
  }


  /* BUTTON */

  .autodrape-car-selector__button {
    width: 100%;
    height: 56px;

    margin-top: 18px;

    border: 0;
    border-radius: 7px;

    background: #d90000;
    color: #fff;

    font-family: var(--font-ui--family);
    font-size: 15px;
    font-weight: 800;

    letter-spacing: .01em;

    cursor: pointer;
    transition: all .2s ease;
  }


  .autodrape-car-selector__button:hover {
    background: #8c0000;
  }


  /* TABLET */

  @media (max-width: 900px) {

    .autodrape-car-selector {
      max-width: 660px;
    }

    .autodrape-car-selector__step {
      font-size: 11px;
    }

  }


  /* MOBILE */

  @media (max-width: 749px) {

    .autodrape-car-selector {
      padding: 22px 20px 24px;
      border-radius: 16px;
    }


    .autodrape-car-selector__steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      align-items: center;
      position: relative;
      margin-bottom: 20px;
    }


    .autodrape-car-selector__divider {
      display: none;
    }


    .autodrape-car-selector__step {
      min-width: 0;
      position: relative;
      z-index: 1;
      flex-direction: column;
      gap: 8px;
      padding: 0 4px;
      font-size: clamp(9px, 2.5vw, 11px);
      letter-spacing: .01em;
      line-height: 1.15;
      text-align: center;
      white-space: normal;
    }

    .autodrape-car-selector__step:nth-child(1)::after,
    .autodrape-car-selector__step:nth-child(3)::after {
      content: '';
      position: absolute;
      z-index: 0;
      top: 15px;
      left: calc(50% + 15px);
      width: calc(100% - 30px);
      height: 1px;
      background: linear-gradient(90deg, #d2d2d2, #e7e7e7);
    }


    .autodrape-car-selector__number {
      position: relative;
      z-index: 1;
      width: 30px;
      height: 30px;
      font-size: 12px;
    }


    .autodrape-car-selector__fields {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .autodrape-car-selector__field label {
      margin-bottom: 7px;
      font-size: 11px;
    }

    .autodrape-car-selector__select-wrap select {
      height: 52px;
      font-size: 14px;
    }


    .autodrape-car-selector__button {
      height: 54px;
      margin-top: 16px;
      border-radius: 9px;
      font-size: 14px;
    }

  }

  @media (max-width: 360px) {
    .autodrape-car-selector {
      padding-right: 16px;
      padding-left: 16px;
    }

    .autodrape-car-selector__step {
      padding: 0 2px;
      font-size: 8px;
      text-align: center;
    }

    .autodrape-car-selector__number {
      width: 28px;
      height: 28px;
      font-size: 11px;
    }
  }

</style>


<script>

  document.addEventListener('DOMContentLoaded', function () {

    const brandSelect =
      document.getElementById('autodrape-brand');

    const modelSelect =
      document.getElementById('autodrape-model');

    const yearSelect =
      document.getElementById('autodrape-year');

    const findButton =
      document.getElementById('autodrape-find-products');

    const selectorRoot =
      document.querySelector('.autodrape-car-selector');

    const stepItems = selectorRoot
      ? selectorRoot.querySelectorAll('.autodrape-car-selector__step')
      : [];

    function setActiveStep(stepNumber) {
      stepItems.forEach(function (step, index) {
        step.classList.toggle('is-active', index === stepNumber - 1);
      });
    }

    setActiveStep(1);


    /*
     * Shopify Metaobject data
     *
     * We expose all Car Model entries from Liquid.
     * Each model contains:
     * - model_name
     * - brand reference
     * - year_range
     */

    const carModels = [

      {% paginate metaobjects.car_model.values by 250 %}
      {% for model in metaobjects.car_model.values %}

        {
          id: {{ model.system.id | json }},
          handle: {{ model.system.handle | json }},
          name: {{ model.model_name.value | json }},
          yearRange: {{ model.year_range.value | json }},
          brandId: {% if model.brand.value %}{{ model.brand.value.system.id | json }}{% else %}null{% endif %},
          brandHandle: {% if model.brand.value %}{{ model.brand.value.system.handle | json }}{% else %}null{% endif %}
        }

        {% unless forloop.last %},{% endunless %}

      {% endfor %}
      {% endpaginate %}

    ];


    /*
     * BRAND → MODEL
     */

    /*
     * Slug helpers - mirror car-results-content.liquid so the `model` value
     * placed in the URL resolves against the exact same cleaned model names.
     * (The metaobject handle is NOT what Car Results expects.)
     */

    function escapeRegExp(value) {
      return String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function slug(value) {
      return String(value || '').toLowerCase().trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    }

    function cleanModelName(value, brandHandle) {
      var name = String(value || '')
        .replace(/[\u2013\u2014]/g, '-')
        .replace(/\s+/g, ' ')
        .trim();
      name = name.replace(/\s+(?:19|20)\d{2}\s*-\s*(?:19|20)\d{2}$/i, '');
      name = name.replace(/\s+(?:19|20)\d{2}$/i, '');
      if (brandHandle) {
        var prefixRe = new RegExp('^(?:' + escapeRegExp(brandHandle) + ')\\s+', 'i');
        name = name.replace(prefixRe, '');
      }
      return name.replace(/\s+/g, ' ').trim();
    }

    brandSelect.addEventListener('change', function () {

      const brandId =
        this.options[this.selectedIndex].dataset.brandId;

      /*
       * Picking a brand moves the highlighted step forward to
       * "Select Model" so the next required step is clearly shown.
       */
      setActiveStep(brandId ? 2 : 1);

      modelSelect.innerHTML =
        '<option value="">Select Model</option>';

      yearSelect.innerHTML =
        '<option value="">Select Year</option>';

      modelSelect.disabled = true;
      yearSelect.disabled = true;


      if (!brandId) {
        return;
      }


      const filteredModels =
        carModels.filter(function (model) {

          return String(model.brandId) === String(brandId);

        });


      const seenModels = {};


      filteredModels.forEach(function (model) {

        /*
         * A Car Model can have multiple metaobject entries that share the
         * same model name but differ by year range (e.g. "Corolla" with
         * 2003–2008 / 2009–2014 / 2015–2020). Show each unique model name
         * only once here - all of that model's year ranges are collected
         * in the Year dropdown when the model is selected.
         */

        const cleanName =
          cleanModelName(model.name, model.brandHandle);

        const modelKey =
          slug(cleanName);

        if (!modelKey || seenModels[modelKey]) {
          return;
        }

        seenModels[modelKey] = true;

        const option =
          document.createElement('option');

        option.value =
          modelKey;

        option.textContent =
          cleanName;

        option.dataset.modelId =
          model.id;

        modelSelect.appendChild(option);

      });


      modelSelect.disabled =
        filteredModels.length === 0;

    });


    /*
     * MODEL → YEAR RANGES
     *
     * Dynamically collects every Year Range stored on the selected Car
     * Model's metaobject entries (e.g. 2003–2008 / 2009–2014 / 2015–2020
     * for Corolla) and shows them as individual options - nothing is
     * hardcoded.
     */

    modelSelect.addEventListener('change', function () {

      if (this.value) {
        setActiveStep(3);
      } else if (brandSelect.value) {
        setActiveStep(2);
      } else {
        setActiveStep(1);
      }

      const brandId =
        brandSelect.options[brandSelect.selectedIndex].dataset.brandId;

      const selectedValue =
        this.value;

      yearSelect.innerHTML =
        '<option value="">Select Year</option>';

      yearSelect.disabled = true;


      if (!brandId || !selectedValue) {
        return;
      }


      /*
       * A model name may exist on several metaobject entries, each with
       * its own Year Range. Collect every range belonging to the selected
       * brand + cleaned model name and render one option per range - e.g.
       * selecting "Corolla" shows 2003–2008 / 2009–2014 / 2015–2020.
       *
       * The stored field value can be:
       *   2015–2021                      (en-dash range)
       *   2015-2021                      (hyphen range)
       *   2015–2021, 2023–2025           (comma-separated ranges)
       *   2020                           (single year, kept as-is)
       *
       * Each range becomes one <option>. The label keeps the en-dash form
       * (2020–2022) while the value is the URL-safe hyphen form
       * (2020-2022) so the selection round-trips in the query string and
       * still parses with parseInt() on the Car Results page.
       */

      const matchingModels =
        carModels.filter(function (model) {

          return (
            String(model.brandId) === String(brandId) &&
            slug(cleanModelName(model.name, model.brandHandle)) === selectedValue
          );

        });


      const yearOptions = [];

      const seenRanges = {};

      matchingModels.forEach(function (model) {

        const ranges =
          String(model.yearRange || '')
            .replace(/[–—]/g, '-')
            .split(',')
            .map(function (range) {
              return range.trim();
            })
            .filter(Boolean);

        ranges.forEach(function (rangeValue) {

          if (seenRanges[rangeValue]) {
            return;
          }

          seenRanges[rangeValue] = true;

          const parts =
            rangeValue.split('-');

          let label = rangeValue;
          let optionValue = rangeValue;
          let sortKey = 0;

          if (parts.length === 2) {

            const startYear =
              parseInt(parts[0].trim(), 10);

            const endYear =
              parseInt(parts[1].trim(), 10);

            if (
              !isNaN(startYear) &&
              !isNaN(endYear) &&
              startYear <= endYear
            ) {

              optionValue =
                startYear + '-' + endYear;

              label =
                startYear + '–' + endYear;

              sortKey =
                startYear;

            }

          } else {

            /*
             * Also support a single year if ever needed.
             */

            const singleYear =
              parseInt(rangeValue.trim(), 10);

            if (isNaN(singleYear)) {
              return;
            }

            optionValue =
              String(singleYear);

            label =
              String(singleYear);

            sortKey =
              singleYear;

          }

          yearOptions.push({
            label: label,
            value: optionValue,
            sortKey: sortKey
          });

        });

      });


      yearOptions.sort(function (a, b) {
        return a.sortKey - b.sortKey;
      });


      yearOptions.forEach(function (yearOption) {

        const option =
          document.createElement('option');

        option.value =
          yearOption.value;

        option.textContent =
          yearOption.label;

        yearSelect.appendChild(option);

      });


      yearSelect.disabled =
        yearSelect.options.length <= 1;

    });


    yearSelect.addEventListener('change', function () {

      if (this.value) {
        setActiveStep(3);
      } else if (modelSelect.value) {
        setActiveStep(3);
      } else if (brandSelect.value) {
        setActiveStep(2);
      } else {
        setActiveStep(1);
      }

    });


    /*
     * FIND PRODUCTS
     *
     * For now we pass the selected data forward.
     * Product filtering will be connected in the next step.
     */

    findButton.addEventListener('click', function () {

  const brand = brandSelect.value;
  const model = modelSelect.value;
  const year = yearSelect.value;

  if (!brand || !model || !year) {
    alert('Please select your brand, model and year.');
    return;
  }

  const params = new URLSearchParams({
    brand: brand,
    model: model,
    year: year
  });

  window.location.href =
    '/pages/car-results?' + params.toString();

});


    /*
     * URL QUERY PARAM PRE-SELECTION
     *
     * Supports deep links like:
     *   /pages/shop-by-car?brand=toyota
     *   /pages/shop-by-car?brand=toyota&model=corolla
     *   /pages/shop-by-car?brand=toyota&model=corolla&year=2020-2022
     *   /pages/shop-by-car?brand=toyota&model=corolla&year=2021
     *
     * Each select is populated by dispatching the same "change" events
     * used by the manual flow, so models/years populate automatically.
     * A range value (e.g. year=2020-2022) is matched exactly; a legacy
     * single-year value (e.g. year=2021) falls back to the option whose
     * range contains that year.
     */

    (function preselectFromUrl() {

      const urlParams = new URLSearchParams(window.location.search);

      const urlBrand = urlParams.get('brand');
      const urlModel = urlParams.get('model');
      const urlYear = urlParams.get('year');

      if (!urlBrand) {
        return;
      }

      const brandOption = brandSelect.querySelector(
        'option[value="' + urlBrand + '"]'
      );

      if (brandOption) {
        brandSelect.value = urlBrand;
        brandSelect.dispatchEvent(new Event('change'));
      }

      if (urlModel) {
        const modelOption = modelSelect.querySelector(
          'option[value="' + urlModel + '"]'
        );

        if (modelOption) {
          modelSelect.value = urlModel;
          modelSelect.dispatchEvent(new Event('change'));
        }
      }

      if (urlYear) {
        let yearOption = yearSelect.querySelector(
          'option[value="' + urlYear + '"]'
        );

        /*
         * The year select exposes ranges now (e.g. "2020-2022"), so a
         * legacy deep link that passes a single year (e.g. year=2021)
         * won't match an option value exactly. Fall back to the option
         * whose range contains the requested year.
         */
        if (!yearOption) {

          const requestedYear =
            parseInt(urlYear, 10);

          if (!isNaN(requestedYear)) {

            yearOption =
              Array.prototype.find.call(
                yearSelect.options,
                function (option) {

                  if (!option.value) {
                    return false;
                  }

                  const rangeParts =
                    option.value.split('-');

                  const rangeStart =
                    parseInt(rangeParts[0], 10);

                  const rangeEnd =
                    parseInt(
                      rangeParts[rangeParts.length - 1],
                      10
                    );

                  return (
                    !isNaN(rangeStart) &&
                    !isNaN(rangeEnd) &&
                    requestedYear >= rangeStart &&
                    requestedYear <= rangeEnd
                  );

                }
              );

          }

        }

        if (yearOption) {
          yearSelect.value = yearOption.value;
          yearSelect.dispatchEvent(new Event('change'));
        }
      }

    })();

  });

</script>
