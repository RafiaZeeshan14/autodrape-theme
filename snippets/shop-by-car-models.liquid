{% doc %}
  Renders the dynamic brand-specific model directory for Shop By Car.

  All car model records are emitted from the existing car_model metaobject.
  The browser filters them by the brand query parameter, groups records of
  the same model into a single card (year-range suffixes and brand prefixes
  are stripped from the raw record names), and switches generation images
  without a page reload.

  @example
  {% render 'shop-by-car-models' %}
{% enddoc %}
{% render 'vehicle-heading-font' %}


{% comment %} Brand data is used to populate the selected brand header. {% endcomment %}
<div class="ad-sbc-brands" data-ad-sbc-brands hidden>
  {% for brand in metaobjects.car_brand.values %}
    <div
      class="ad-sbc-brand"
      data-handle="{{ brand.system.handle | handleize }}"
      data-name="{{ brand.brand_name.value | escape }}"
      data-logo="{% if brand.brand_logo.value %}{{ brand.brand_logo.value | image_url: width: 400 }}{% endif %}"
    ></div>
  {% endfor %}
</div>

<div class="shop-by-car-models" data-ad-sbc-models hidden>
  <div class="shop-by-car-models__hero">
    <div class="shop-by-car-models__hero-logo">
      <img class="ad-sbc-hero-img" alt="" width="220" height="110" hidden>
    </div>
    <h1 class="shop-by-car-models__hero-title">ALL <span data-ad-sbc-hero-brand>BRAND</span> MODELS</h1>
    <p class="shop-by-car-models__hero-desc" data-ad-sbc-hero-desc></p>
  </div>

  <div class="shop-by-car-models__benefits" aria-label="Product benefits">
    <span><b aria-hidden="true">&#10003;</b> PERFECT FIT</span>
    <span><b aria-hidden="true">&#10003;</b> UV PROTECTION</span>
    <span><b aria-hidden="true">&#10003;</b> EASY TO INSTALL</span>
    <span><b aria-hidden="true">&#10003;</b> PREMIUM QUALITY</span>
  </div>

  <div class="shop-by-car-models__grid" data-ad-sbc-grid></div>
  <p class="shop-by-car-models__empty" data-ad-sbc-empty hidden>No models found for this brand.</p>
</div>

<script type="application/json" data-ad-sbc-model-data>
  [
    {% paginate metaobjects.car_model.values by 250 %}
    {% for model in metaobjects.car_model.values %}
      {% assign model_brand = model.brand.value %}
      {% assign model_image = model.image.value | default: model.model_image.value %}
      {
        "handle": {{ model.system.handle | json }},
        "name": {{ model.model_name.value | default: model.model_name | json }},
        "yearRange": {{ model.year_range.value | default: model.year_range | json }},
        "brand": {% if model_brand %}{{ model_brand.system.handle | handleize | json }}{% else %}null{% endif %},
        "image": {% if model_image %}{{ model_image | image_url: width: 900 | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
    {% endpaginate %}
  ]
</script>

<style>
  .shop-by-car-models { position: relative; width: 100%; padding: 52px 24px 84px; background: #fff; color: #111; }
  .shop-by-car-models__hero { max-width: 900px; margin: 0 auto 30px; text-align: center; }
  .shop-by-car-models__hero-logo { min-height: 90px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
  .shop-by-car-models__hero-logo img { display: block; max-width: 220px; max-height: 100px; object-fit: contain; }
  .shop-by-car-models__hero-title { margin: 0; font-family: var(--font-ui--family); font-size: clamp(30px, 4vw, 48px); font-weight: 900; line-height: 1.1; letter-spacing: 0; }
  .shop-by-car-models__hero-title span { color: #d90000; }
  .shop-by-car-models__hero-desc { margin: 12px 0 0; color: #666; font-family: var(--font-ui--family); font-size: 16px; }
  .shop-by-car-models__benefits { display: flex; flex-wrap: wrap; justify-content: center; gap: 0; margin: 0 auto 38px; max-width: 960px; }
  .shop-by-car-models__benefits span { display: inline-flex; align-items: center; gap: 9px; padding: 0 25px; border-right: 1px solid #ddd; font: 700 13px var(--font-ui--family); white-space: nowrap; }
  .shop-by-car-models__benefits span:last-child { border-right: 0; }
  .shop-by-car-models__benefits b { color: #d90000; font-size: 20px; line-height: 1; }
  .shop-by-car-models__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; max-width: 1180px; margin: 0 auto; }
  .shop-by-car-models__card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #e3e3e3; border-radius: 12px; background: #fff; box-shadow: 0 5px 16px rgba(0, 0, 0, .07); transition: transform .2s ease, box-shadow .2s ease; }
  .shop-by-car-models__card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0, 0, 0, .11); }
  .shop-by-car-models__card-image { display: flex; align-items: center; justify-content: center; height: 235px; padding: 12px 20px; background: #fafafa; }
  .shop-by-car-models__card-image img { width: 100%; height: 100%; object-fit: contain; }
  .shop-by-car-models__card-body { display: flex; flex: 1; flex-direction: column; align-items: center; padding: 18px 16px 16px; text-align: center; }
  .shop-by-car-models__card-brand { color: #666; font: 700 14px var(--font-ui--family); letter-spacing: .3px; }
  .shop-by-car-models__card-title { margin: 3px 0 9px; font: 900 30px/1.1 var(--font-ui--family); text-transform: uppercase; }
  .shop-by-car-models__accent { width: 35px; height: 3px; margin-bottom: 16px; background: #d90000; }
  .shop-by-car-models__label { margin-bottom: 10px; color: #666; font: 700 13px var(--font-ui--family); text-transform: uppercase; }
  .shop-by-car-models__years { display: flex; flex-wrap: wrap; justify-content: center; gap: 9px; min-height: 39px; margin-bottom: 20px; }
  .shop-by-car-models__year { padding: 9px 16px; border: 1px solid #d90000; border-radius: 9px; background: #fff; color: #d90000; font: 700 13px var(--font-ui--family); cursor: pointer; }
  .shop-by-car-models__year.is-active, .shop-by-car-models__year:hover { background: #d90000; color: #fff; }
  .shop-by-car-models__button { display: block; width: 100%; margin-top: auto; padding: 14px 12px; border: 0; border-radius: 8px; background: #d90000; color: #fff; text-align: center; text-decoration: none; font: 800 14px var(--font-ui--family); }
  .shop-by-car-models__button:hover { background: #850000; }
  .shop-by-car-models__empty { margin: 40px auto; text-align: center; font: 600 16px var(--font-ui--family); }
  @media (max-width: 991px) { .shop-by-car-models__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .shop-by-car-models { padding: 38px 14px 60px; }
    .shop-by-car-models__benefits { gap: 14px 0; }
    .shop-by-car-models__benefits span { width: 50%; padding: 0 10px; justify-content: center; border-right: 0; }
    .shop-by-car-models__grid { grid-template-columns: 1fr; }
    .shop-by-car-models__card-image { height: 210px; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-ad-sbc-models]');
    var dataNode = document.querySelector('[data-ad-sbc-model-data]');
    if (!root || !dataNode) return;

    var models;
    try { models = JSON.parse(dataNode.textContent); } catch (error) { models = []; }
    var params = new URLSearchParams(window.location.search);
    var brandHandle = (params.get('brand') || '').toLowerCase().trim();
    var brandNode = document.querySelector('[data-ad-sbc-brands] .ad-sbc-brand[data-handle="' + brandHandle + '"]');
    var brandName = brandNode ? brandNode.getAttribute('data-name') : brandHandle.toUpperCase();
    var grid = root.querySelector('[data-ad-sbc-grid]');
    var empty = root.querySelector('[data-ad-sbc-empty]');
    var heroBrand = root.querySelector('[data-ad-sbc-hero-brand]');
    var heroDesc = root.querySelector('[data-ad-sbc-hero-desc]');
    var heroImage = root.querySelector('.ad-sbc-hero-img');
    var selector = document.querySelector('[data-ad-sbc-selector]');

    if (!brandHandle) return;
    if (selector) selector.hidden = true;
    root.hidden = false;
    var page = root.closest('.shop-by-car-page');
    if (page) page.classList.add('has-model-results');
    heroBrand.textContent = brandName.toUpperCase();
    heroDesc.textContent = 'Select your ' + brandName + ' model to find the perfect sunshades for your car.';
    if (brandNode && brandNode.getAttribute('data-logo')) {
      heroImage.src = brandNode.getAttribute('data-logo');
      heroImage.alt = brandName + ' logo';
      heroImage.hidden = false;
    }
    function escapeRegExp(value) {
      return String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }
    var brandPrefixes = {};
    if (brandHandle) brandPrefixes[brandHandle.trim().toLowerCase()] = true;
    if (brandName) brandPrefixes[String(brandName).trim().toLowerCase()] = true;

    // Derive a stable, groupable model name from a raw metaobject record name.
    // Records are stored inconsistently (e.g. "Toyota Corolla 2015-2025",
    // "Camry 2002-2006", "Yaris Sedan 2022", or just "Corolla"). We strip any
    // trailing year range and a leading brand prefix so that all generations of
    // the same model collapse onto one card (Corolla, Camry, Fortuner, ...).
    function cleanModelName(value) {
      var name = String(value || '').replace(/[\u2013\u2014]/g, '-').replace(/\s+/g, ' ').trim();
      name = name.replace(/\s+(?:19|20)\d{2}\s*-\s*(?:19|20)\d{2}$/i, '');
      name = name.replace(/\s+(?:19|20)\d{2}$/i, '');
      if (Object.keys(brandPrefixes).length) {
        var prefixRe = new RegExp('^(?:' + Object.keys(brandPrefixes).map(escapeRegExp).join('|') + ')\\s+', 'i');
        name = name.replace(prefixRe, '');
      }
      return name.replace(/\s+/g, ' ').trim();
    }
    function slug(value) {
      return String(value || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    function normalizeRange(value) {
      return String(value || '').replace(/[\u2013\u2014]/g, '-').replace(/\s+/g, ' ').trim();
    }
    function normalizeName(value) {
      return String(value || '').toLowerCase().replace(/\s+/g, ' ').trim();
    }
    function parseRange(value) {
      var parts = normalizeRange(value).split('-');
      var start = parseInt(parts[0], 10) || 0;
      var end = parseInt(parts[parts.length - 1], 10) || start;
      return { start: start, end: end };
    }
    function compareEntries(a, b) {
      var aRange = parseRange(a.yearRange);
      var bRange = parseRange(b.yearRange);
      if (aRange.start !== bRange.start) return aRange.start - bRange.start;
      if (aRange.end !== bRange.end) return aRange.end - bRange.end;
      return normalizeRange(a.yearRange).localeCompare(normalizeRange(b.yearRange));
    }
    function startYear(range) {
      var parts = normalizeRange(range).split('-');
      return parseInt(parts[0], 10) || 0;
    }
    function makeCard(group) {
      var defaultEntry = group.entries[group.entries.length - 1] || group.entries[0];
      var card = document.createElement('article');
      card.className = 'shop-by-car-models__card';
      card.innerHTML = '<div class="shop-by-car-models__card-image"><img alt=""></div><div class="shop-by-car-models__card-body"><div class="shop-by-car-models__card-brand"></div><h2 class="shop-by-car-models__card-title"></h2><div class="shop-by-car-models__accent"></div><div class="shop-by-car-models__label">AVAILABLE MODEL' + (group.entries.length > 1 ? 'S' : '') + '</div><div class="shop-by-car-models__years"></div><a class="shop-by-car-models__button" href="#">VIEW OPTIONS <span aria-hidden="true">&#8594;</span></a></div>';
      var image = card.querySelector('img');
      var cardBrand = card.querySelector('.shop-by-car-models__card-brand');
      var title = card.querySelector('.shop-by-car-models__card-title');
      var years = card.querySelector('.shop-by-car-models__years');
      var link = card.querySelector('.shop-by-car-models__button');
      cardBrand.textContent = brandName.toUpperCase();
      title.textContent = group.name;

      function selectEntry(entry, activeButton) {
        if (entry.image) {
          image.src = entry.image;
          image.alt = brandName + ' ' + group.name;
          image.hidden = false;
        } else {
          image.removeAttribute('src');
          image.alt = '';
          image.hidden = true;
        }
        Array.prototype.forEach.call(years.children, function (button) { button.classList.toggle('is-active', button === activeButton); });
        link.href = '/pages/car-results?brand=' + encodeURIComponent(brandHandle) + '&model=' + encodeURIComponent(slug(group.name)) + '&year=' + startYear(entry.yearRange);
      }
      group.entries.forEach(function (entry, index) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'shop-by-car-models__year';
        button.textContent = normalizeRange(entry.yearRange).replace('-', ' - ');
        button.addEventListener('click', function () { selectEntry(entry, button); });
        years.appendChild(button);
        if (entry === defaultEntry || (defaultEntry && normalizeRange(entry.yearRange) === normalizeRange(defaultEntry.yearRange))) {
          selectEntry(entry, button);
        }
      });
      return card;
    }

    var groups = {};
    models.filter(function (model) { return model.brand === brandHandle && model.name; }).forEach(function (model) {
      var clean = cleanModelName(model.name);
      var key = normalizeName(clean);
      if (!key) return;
      if (!groups[key]) groups[key] = { name: clean, entries: [] };
      if (!groups[key].entries.some(function (entry) { return normalizeRange(entry.yearRange) === normalizeRange(model.yearRange); })) {
        groups[key].entries.push(model);
      }
    });
    Object.keys(groups).sort(function (a, b) {
      return normalizeName(groups[a].name).localeCompare(normalizeName(groups[b].name));
    }).forEach(function (key) {
      groups[key].entries.sort(compareEntries);
      grid.appendChild(makeCard(groups[key]));
    });
    empty.hidden = Object.keys(groups).length > 0;
  })();
</script>
