{% doc %}
  Renders the brand-specific "Models" view for the Shop By Car flow.

  Shown when the visitor lands on a deep link such as
  `/pages/shop-by-car?brand=toyota` (or any page carrying `?brand=<handle>`).

  It renders:
    1. A brand hero — logo (from the `car_brand` metaobject), the heading
       "[BRAND] CAR MODELS" and a short description.
    2. A small benefits strip.
    3. A section heading "ALL [BRAND] MODELS".
    4. A responsive grid of model/generation cards read from the existing
       `car_model` metaobjects. Each generation/year-range record becomes its
       OWN card (e.g. two Corolla records with different year ranges render as
       two separate cards).

  IMPORTANT — why this is client-side driven:
  `request.query_string` is NOT reliably populated in this store's Shopify
  Liquid context (verified empty even for `/pages/all-brands?brand=toyota` on
  the local dev server). The `brand` URL parameter is therefore read with
  `URLSearchParams` — the same proven pattern already used by
  `car-results-content.liquid`. Every brand/model value is rendered
  server-side as `data-*` attributes so the markup is correct and filterable
  even before / without JavaScript.

  Each model card links to the EXISTING next step:
  `/pages/car-results?brand=<handle>&model=<handle>&year=<end_year>` using the
  very same year-range matching the existing car-results page already
  understands — so the existing matching system is left untouched.

  @example
  {% render 'shop-by-car-models' %}
{% enddoc %}

{% comment %}
  Per-brand lookup data (hidden). The JS uses this to populate the brand hero
  once the `brand` parameter is known from the URL. `data-handle` is handleized
  so the comparison is case/whitespace insensitive.
{% endcomment %}
<div class="ad-sbc-brands" data-ad-sbc-brands style="display: none;">
  {% for b in metaobjects.car_brand.values %}
    {% assign b_handle = b.system.handle | handleize %}
    {% assign b_name = b.brand_name.value %}
    {% assign b_logo = '' %}
    {% if b.brand_logo.value %}{% assign b_logo = b.brand_logo.value | image_url: width: 400 %}{% endif %}
    <div
      class="ad-sbc-brand"
      data-handle="{{ b_handle }}"
      data-name="{{ b_name | escape }}"
      data-logo="{{ b_logo }}"
    >Select your {{ b_name }} model to find the perfect sunshades for your car.</div>
  {% endfor %}
</div>

<div class="shop-by-car-models" data-ad-sbc-models style="display: none;">

  <!-- Breadcrumb -->
  <nav class="shop-by-car-models__breadcrumb" aria-label="breadcrumb">
    <a href="/">Home</a>
    <span class="shop-by-car-models__breadcrumb-sep">&gt;</span>
    <a href="/pages/shop-by-car">Shop By Car</a>
    <span class="shop-by-car-models__breadcrumb-sep">&gt;</span>
    <span class="shop-by-car-models__breadcrumb-brand" data-ad-sbc-breadcrumb>?</span>
  </nav>

  <!-- Brand hero (populated by JS from the per-brand lookup above) -->
  <div class="shop-by-car-models__hero" data-ad-sbc-hero>
    <div class="shop-by-car-models__hero-logo">
      <img class="ad-sbc-hero-img" alt="" style="display: none; max-width: 220px; height: auto;">
    </div>
    <h1 class="shop-by-car-models__hero-title">
      <span class="shop-by-car-models__hero-brand" data-ad-sbc-hero-brand>CAR</span> CAR MODELS
    </h1>
    <p class="shop-by-car-models__hero-desc" data-ad-sbc-hero-desc></p>
  </div>

  <!-- Benefits strip -->
  <div class="shop-by-car-models__benefits">
    <div class="shop-by-car-models__benefit">
      <span class="shop-by-car-models__benefit-bullet">&#10003;</span>
      <span class="shop-by-car-models__benefit-label">PERFECT FIT</span>
      <span class="shop-by-car-models__benefit-desc">Custom-fit sunshades for every model.</span>
    </div>
    <div class="shop-by-car-models__benefit">
      <span class="shop-by-car-models__benefit-bullet">&#10003;</span>
      <span class="shop-by-car-models__benefit-label">UV PROTECTION</span>
      <span class="shop-by-car-models__benefit-desc">Blocks heat and harmful UV rays.</span>
    </div>
    <div class="shop-by-car-models__benefit">
      <span class="shop-by-car-models__benefit-bullet">&#10003;</span>
      <span class="shop-by-car-models__benefit-label">EASY TO INSTALL</span>
      <span class="shop-by-car-models__benefit-desc">Quick setup in seconds.</span>
    </div>
    <div class="shop-by-car-models__benefit">
      <span class="shop-by-car-models__benefit-bullet">&#10003;</span>
      <span class="shop-by-car-models__benefit-label">PREMIUM QUALITY</span>
      <span class="shop-by-car-models__benefit-desc">Durable materials for long-lasting use.</span>
    </div>
  </div>

  <!-- Section heading -->
  <h2 class="shop-by-car-models__section-title">
    ALL <span class="shop-by-car-models__section-brand" data-ad-sbc-section-brand>?</span> MODELS
  </h2>

    <!-- Model grid (every generation record is its own card) -->
  <div class="shop-by-car-models__grid">
    {% for m in metaobjects.car_model.values %}
      {% comment %}
        Resolve the model's brand reference safely. `m.brand.value` can be
        blank on some records, so we guard it (mirrors the selector pattern).
      {% endcomment %}
      {% assign m_brand_ref = m.brand.value %}
      {% assign m_brand_handle = '' %}
      {% assign m_brand_name = '' %}
      {% if m_brand_ref %}
        {% assign m_brand_handle = m_brand_ref.system.handle | handleize %}
        {% assign m_brand_name = m_brand_ref.brand_name.value %}
      {% endif %}

      {% assign m_model_name = m.model_name.value | strip %}
      {% assign m_model_handle = m_model_name | handleize %}

      {% comment %}
        year_range is stored as e.g. "2015–2021" (en dash) or "2015-2021".
        Normalise dashes then split. Guard against a missing second part.
      {% endcomment %}
      {% assign m_year_range = m.year_range.value | strip %}
      {% assign m_year_clean = m_year_range | replace: '–', '-' | replace: '—', '-' | strip %}
      {% assign m_year_parts = m_year_clean | split: '-' %}
      {% assign m_start_year = m_year_parts[0] | strip | plus: 0 %}
      {% assign m_end_year = 0 %}
      {% if m_year_parts.size > 1 %}
        {% assign m_end_year = m_year_parts[1] | strip | plus: 0 %}
      {% endif %}

      {% assign m_img_url = '' %}
      {% if m.model_image.value %}{% assign m_img_url = m.model_image.value | image_url: width: 600 %}{% endif %}

      <a
        href="/pages/car-results?brand={{ m_brand_handle | url_encode }}&model={{ m_model_handle | url_encode }}&year={{ m_end_year }}"
        class="shop-by-car-models__card"
        data-brand="{{ m_brand_handle }}"
        data-model="{{ m_model_handle }}"
        data-start-year="{{ m_start_year }}"
        data-end-year="{{ m_end_year }}"
        style="display: none;"
      >
        <div class="shop-by-car-models__card-image">
          {% if m_img_url != blank %}
            <img src="{{ m_img_url }}" alt="{{ m_brand_name }} {{ m_model_name }}" loading="lazy" class="shop-by-car-models__card-img">
          {% else %}
            <div class="shop-by-car-models__card-placeholder">
              <svg viewBox="0 0 24 24" width="54" height="54" fill="none" stroke="#bbb" stroke-width="1.5"><path d="M3 13l2-6h14l2 6v6a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><circle cx="8" cy="17" r="1.2"/><circle cx="17" cy="17" r="1.2"/></svg>
            </div>
          {% endif %}
        </div>
        <div class="shop-by-car-models__card-body">
          <div class="shop-by-car-models__card-title">{{ m_brand_name | upcase }} {{ m_model_name | upcase }}</div>
          <div class="shop-by-car-models__card-years">{{ m_start_year }} – {{ m_end_year }}</div>
          <div class="shop-by-car-models__card-btn">SELECT MODEL →</div>
        </div>
      </a>
    {% endfor %}

        <div class="shop-by-car-models__empty" data-ad-sbc-empty style="display: none;">
      <p>No models found for this brand.</p>
    </div>
  </div>
</div>

<style>
  .shop-by-car-models {
    width: 100%;
    background: #fff;
    padding: 40px 20px 60px;
  }

  .shop-by-car-models__breadcrumb {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 13px;
    color: #888;
    margin-bottom: 18px;
  }
  .shop-by-car-models__breadcrumb a { color: #888; text-decoration: none; }
  .shop-by-car-models__breadcrumb a:hover { text-decoration: underline; }
  .shop-by-car-models__breadcrumb-sep { margin: 0 6px; color: #bbb; }

  .shop-by-car-models__hero { text-align: center; margin-bottom: 34px; }
  .shop-by-car-models__hero-logo { display: flex; justify-content: center; margin-bottom: 14px; }
  .shop-by-car-models__hero-title {
    margin: 0;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: #111;
  }
  .shop-by-car-models__hero-brand { color: #a90000; }
  .shop-by-car-models__hero-desc {
    margin: 10px 0 0;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 15px;
    color: #666;
  }

  .shop-by-car-models__benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-bottom: 34px;
  }
  .shop-by-car-models__benefit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
  }
  .shop-by-car-models__benefit-bullet { color: #a90000; font-size: 16px; }
  .shop-by-car-models__benefit-desc {
    font-size: 11px;
    color: #999;
    font-weight: 400;
  }

  .shop-by-car-models__section-title {
    margin: 0 0 22px;
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 26px;
    font-weight: 800;
    text-align: center;
    color: #111;
    text-transform: uppercase;
    letter-spacing: -0.3px;
  }
  .shop-by-car-models__section-brand { color: #a90000; }

  .shop-by-car-models__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .shop-by-car-models__card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    overflow: hidden;
    transition: all .2s ease;
  }
  .shop-by-car-models__card:hover {
    border-color: #a90000;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
  }
  .shop-by-car-models__card-image {
    width: 100%;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    overflow: hidden;
  }
  .shop-by-car-models__card-img { width: 100%; height: 100%; object-fit: cover; }
  .shop-by-car-models__card-placeholder { display: flex; align-items: center; justify-content: center; }
  .shop-by-car-models__card-body { padding: 16px 18px; }
  .shop-by-car-models__card-title {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 15px;
    font-weight: 800;
    color: #111;
    margin-bottom: 6px;
  }
  .shop-by-car-models__card-years {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 13px;
    color: #666;
    margin-bottom: 12px;
  }
  .shop-by-car-models__card-btn {
    font-family: 'Montserrat', Arial, sans-serif;
    font-size: 13px;
    font-weight: 800;
    color: #a90000;
  }
  .shop-by-car-models__empty { text-align: center; padding: 40px 0; font-family: 'Montserrat', Arial, sans-serif; color: #666; }

  @media (max-width: 991px) {
    .shop-by-car-models__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .shop-by-car-models__grid { grid-template-columns: 1fr; }
    .shop-by-car-models__hero-title { font-size: 28px; }
        .shop-by-car-models { padding: 30px 14px 50px; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-ad-sbc-models]');
    if (!root) return;

    var brandsRoot = document.querySelector('[data-ad-sbc-brands]');
    var selectorWrap = document.querySelector('[data-ad-sbc-selector]');

    var urlBrand = (new URLSearchParams(window.location.search).get('brand') || '').toLowerCase().trim();

    var hero = root.querySelector('[data-ad-sbc-hero]');
    var heroImg = root.querySelector('.ad-sbc-hero-img');
    var heroBrand = root.querySelector('[data-ad-sbc-hero-brand]');
    var heroDesc = root.querySelector('[data-ad-sbc-hero-desc]');
    var breadcrumbBrand = root.querySelector('[data-ad-sbc-breadcrumb]');
    var sectionBrand = root.querySelector('[data-ad-sbc-section-brand]');
    var cards = root.querySelectorAll('.shop-by-car-models__card');
    var empty = root.querySelector('[data-ad-sbc-empty]');

    function populateBrand(brand) {
      var brandEl = brandsRoot ? brandsRoot.querySelector('.ad-sbc-brand[data-handle="' + brand + '"]') : null;
      var displayName = brand.toUpperCase();

      if (brandEl) {
        displayName = (brandEl.getAttribute('data-name') || brand.toUpperCase());
        var logo = brandEl.getAttribute('data-logo');
        if (logo && heroImg) {
          heroImg.src = logo;
          heroImg.alt = displayName + ' logo';
          heroImg.style.display = 'block';
        } else if (heroImg) {
          heroImg.style.display = 'none';
        }
        if (heroDesc) heroDesc.textContent = brandEl.textContent || '';
      } else {
        if (heroImg) heroImg.style.display = 'none';
        if (heroDesc) heroDesc.textContent = 'Select your ' + displayName.toLowerCase() + ' model to find compatible products.';
      }

      var upper = displayName.toUpperCase();
      if (heroBrand) heroBrand.textContent = upper;
      if (sectionBrand) sectionBrand.textContent = upper;
      if (breadcrumbBrand) breadcrumbBrand.textContent = upper;

      var anyMatch = false;
      cards.forEach(function (card) {
        var cardBrand = (card.getAttribute('data-brand') || '').toLowerCase().trim();
        card.style.display = (cardBrand === brand) ? '' : 'none';
        if (cardBrand === brand) anyMatch = true;
      });

      if (empty) empty.style.display = anyMatch ? 'none' : 'block';
    }

    function showModels(brand) {
      if (selectorWrap) selectorWrap.style.display = 'none';
      root.style.display = 'block';
      if (hero) hero.style.display = 'block';
      populateBrand(brand);
    }

    function resetToSelector() {
      if (selectorWrap) selectorWrap.style.display = 'block';
      root.style.display = 'none';
      if (hero) hero.style.display = 'none';
      if (empty) empty.style.display = 'none';
    }

    if (urlBrand) {
      showModels(urlBrand);
    } else {
      resetToSelector();
    }

    /* Honour back/forward navigation between deep links. */
    window.addEventListener('popstate', function () {
      var b = (new URLSearchParams(window.location.search).get('brand') || '').toLowerCase().trim();
      if (b) { showModels(b); } else { resetToSelector(); }
    });
  })();
</script>
