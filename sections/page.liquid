{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page

  Fallback: when the requested page is one of the specialized custom pages
  (e.g. car-results, shop-by-car) but the merchant has not assigned the
  dedicated custom template to the page in the admin, render the correct
  content instead of just the page title. This keeps those URLs working
  regardless of the admin template assignment.

  Policy pages (Privacy Policy, Return & Exchange / Refund Policy, Terms &
  Conditions, Shipping & Delivery Policy) are rendered through the shared
  policy-page layout so every policy keeps the same premium, card-based UI.
{% endcomment %}

{% assign policy_handles = 'privacy-policy,refund-policy,return-policy,return-and-exchange-policy,return-exchange-policy,terms-of-service,terms-and-conditions,terms-conditions,shipping-policy,shipping-delivery-policy,delivery-policy' | split: ',' %}
{% assign is_policy_page = false %}
{% for policy_handle in policy_handles %}
  {% if page.handle == policy_handle %}
    {% assign is_policy_page = true %}
  {% endif %}
{% endfor %}

{% comment %}
  Fallback for stores where a policy URL slug was customized in the admin:
  any page whose URL matches one of the store's configured policy URLs
  (the same URLs the footer links to) is treated as a policy page.
{% endcomment %}
{% unless is_policy_page %}
  {% if shop.privacy_policy.url and page.url == shop.privacy_policy.url %}
    {% assign is_policy_page = true %}
  {% elsif shop.refund_policy.url and page.url == shop.refund_policy.url %}
    {% assign is_policy_page = true %}
  {% elsif shop.terms_of_service.url and page.url == shop.terms_of_service.url %}
    {% assign is_policy_page = true %}
  {% elsif shop.shipping_policy.url and page.url == shop.shipping_policy.url %}
    {% assign is_policy_page = true %}
  {% endif %}
{% endunless %}

{% if page.handle == 'car-results' %}
  {% render 'car-results-content' %}
{% elsif page.handle == 'shop-by-car' %}
  {% render 'shop-by-car-content' %}
{% elsif page.handle == 'all-brands' or page.handle == 'shop-by-brand' %}
  {% render 'all-brands-content' %}
{% elsif page.handle == 'all-products' %}
  {% render 'all-products-content' %}
{% elsif is_policy_page %}
  {% render 'policy-page', policy: page %}
{% else %}
  <div class="ad-generic-page">
    {% render 'page-back-link' %}
    <h1>{{ page.title }}</h1>

    {{ page.content }}
  </div>
{% endif %}

<style>
  .ad-generic-page {
    position: relative;
    padding: 72px 24px 96px;
  }

  .ad-generic-page > .ad-page-back {
    position: absolute;
    top: 28px;
    left: 24px;
  }
</style>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
