<style>
  .ad-protection {
    width: 100%;
    padding: 0 0 64px;
    color: #ffffff;
    background: linear-gradient(180deg, #7d1515, #5f1010);
  }

  .ad-protection__container {
    width: min(100% - 48px, 1440px);
    margin: 0 auto;
    padding: 24px 0 0;
  }

  .ad-protection__heading {
    text-align: center;
    margin-bottom: 24px;
  }

  .ad-protection__heading h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(26px, 2.8vw, 40px);
    line-height: 1.08;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .ad-protection__heading p {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    line-height: 1.65;
  }

  .ad-protection__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .ad-protection__card {
    min-height: 184px;
    padding: 24px 16px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: transparent;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .ad-protection__card:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.06);
  }

  .ad-protection__icon {
    width: 54px;
    height: 54px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }

  .ad-protection__icon svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: #ffffff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ad-protection__card h3 {
    min-height: 44px;
    margin: 0;
    color: #ffffff;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .ad-protection__card p {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    line-height: 1.6;
  }

  @media screen and (max-width: 1050px) {
    .ad-protection__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 600px) {
    .ad-protection {
      padding-bottom: 40px;
    }

    .ad-protection__container {
      width: calc(100% - 28px);
    }

    .ad-protection__heading {
      margin-bottom: 18px;
    }

    .ad-protection__heading h2 {
      font-size: clamp(22px, 8vw, 30px);
    }

    .ad-protection__heading p {
      font-size: 12px;
    }

    .ad-protection__grid {
      grid-template-columns: 1fr;
    }

    .ad-protection__card {
      min-height: 162px;
      padding: 22px 12px 16px;
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .ad-protection__card:last-child {
      border-bottom: 0;
    }

    .ad-protection__card h3 {
      font-size: 16px;
    }

    .ad-protection__card p {
      font-size: 11px;
    }
  }
</style>


