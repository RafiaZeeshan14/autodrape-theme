<section class="autodrape-contact">
  <div class="contact-card">
    {% if section.settings.image != blank %}
      <div
        class="contact-bg"
        style="background-image: url('{{ section.settings.image | image_url: width: 1800 }}');"
      ></div>
    {% endif %}

    <div class="contact-overlay"></div>

    <div class="contact-content">
      <div class="contact-eyebrow">Need help?</div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="contact-subheading">{{ section.settings.subheading }}</p>

      <div class="contact-details">
        {% if section.settings.phone != blank %}
          <a href="tel:{{ section.settings.phone | remove: ' ' }}">
            <span class="contact-icon">Call</span>
            <span>{{ section.settings.phone }}</span>
          </a>
        {% endif %}

        {% if section.settings.email != blank %}
          <a href="mailto:{{ section.settings.email }}">
            <span class="contact-icon">Mail</span>
            <span>{{ section.settings.email }}</span>
          </a>
        {% endif %}

        {% if section.settings.address != blank %}
          <div class="contact-detail">
            <span class="contact-icon">Visit</span>
            <span>{{ section.settings.address }}</span>
          </div>
        {% endif %}
      </div>

      <a class="contact-button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_text }}
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .autodrape-contact {
    width: 100%;
    padding: 8px 0 32px;
  }

  .contact-card {
    position: relative;
    width: min(100% - 48px, 1200px);
    min-height: 320px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--ad-radius-xl);
    background: #0b0b0d;
    box-shadow: var(--ad-shadow-lg);
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    filter: saturate(0.96) contrast(1.05);
  }

  .contact-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top left, rgba(216, 31, 25, 0.16), transparent 24%),
      linear-gradient(90deg, rgba(7, 7, 8, 0.98) 0%, rgba(7, 7, 8, 0.94) 40%, rgba(7, 7, 8, 0.25) 100%);
  }

  .contact-content {
    position: relative;
    z-index: 2;
    width: min(55%, 640px);
    height: 100%;
    padding: 34px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contact-eyebrow {
    margin-bottom: 10px;
    color: #f15d56;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact-content h2 {
    margin: 0 0 8px;
    color: #ffffff;
    font-size: clamp(30px, 3vw, 50px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .contact-subheading {
    margin: 0 0 20px;
    color: rgba(255, 255, 255, 0.74);
    font-size: 15px;
    line-height: 1.7;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
  }

  .contact-details a,
  .contact-detail {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
  }

  .contact-icon {
    min-width: 48px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.86);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }

  .contact-button {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 999px;
    background: linear-gradient(180deg, #f23f38, var(--ad-accent));
    color: #fff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 18px 30px rgba(216, 31, 25, 0.24);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 34px rgba(216, 31, 25, 0.28);
  }

  @media screen and (max-width: 700px) {
    .autodrape-contact {
      padding: 5px 0 28px;
    }

    .contact-card {
      width: calc(100% - 28px);
      min-height: 380px;
    }

    .contact-content {
      width: 100%;
      padding: 28px 20px;
      justify-content: flex-start;
    }

    .contact-bg {
      background-position: 72% center;
    }

    .contact-overlay {
      background:
        linear-gradient(90deg, rgba(7, 7, 8, 0.98), rgba(7, 7, 8, 0.72));
    }
  }
</style>

{% schema %}
{
  "name": "Get In Touch",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Have questions? We're here to help."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+92 300 1234567"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "support@autodrapes.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "123 Auto Street, Karachi, Pakistan"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "CONTACT US"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    }
  ],
  "presets": [
    {
      "name": "Get In Touch"
    }
  ]
}
{% endschema %}
