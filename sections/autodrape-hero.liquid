<section class="autodrape-hero">
  <div class="autodrape-hero__inner">

    <!-- =========================
         HERO BACKGROUND / CAR
         ========================= -->
    <div class="autodrape-hero__visual">
      <img
        src="{{ 'heroimage.png' | asset_url }}"
        alt="AutoDrape premium car sunshades"
        class="autodrape-hero__car"
        loading="eager"
      >
    </div>


    <!-- =========================
         LEFT CONTENT
         ========================= -->
    <div class="autodrape-hero__content">

      <div class="autodrape-hero__eyebrow">
        PREMIUM CAR PROTECTION
      </div>

      <h1 class="autodrape-hero__title">
        <span>PERFECT FIT</span>
        <strong>FOR YOUR CAR</strong>
      </h1>

      <p class="autodrape-hero__description">
        Custom-Fit Car Shades &amp; Accessories<br>
        Engineered for Comfort. Built for Protection.
      </p>

      <a href="/collections/all" class="autodrape-hero__shop-button">
        SHOP NOW <span aria-hidden="true">&#8594;</span>
      </a>


    </div>


    <!-- =========================
         VEHICLE SELECTOR
         ========================= -->
   <!-- EXISTING CAR SELECTOR -->
<div class="autodrape-hero__finder-slot">
  {% render 'autodrape-car-selector' %}
</div>

  </div>
</section>


<style>

/* =========================================================
   FONTS
   ========================================================= */

/* =========================================================
   HERO
   ========================================================= */

.autodrape-hero {
  position: relative;

  width: 100%;

  min-height: 680px;

  margin: 0;
  padding: 0;

  overflow: visible;

  background: #fff;
}


.autodrape-hero__inner {
  position: relative;

  width: 100%;

  min-height: 680px;

  overflow: visible;
}


/* =========================================================
   BACKGROUND / CAR IMAGE
   ========================================================= */

.autodrape-hero__visual {
  position: absolute;

  z-index: 1;

  inset: 0;

  width: 100%;
  height: 100%;

  pointer-events: none;
}


.autodrape-hero__car {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  object-position: center center;
}


/* =========================================================
   LEFT CONTENT
   ========================================================= */

.autodrape-hero__content {
  position: relative;

  z-index: 5;

  width: 44%;

  padding-left: 7%;

  padding-top: 108px;

  box-sizing: border-box;
}


.autodrape-hero__eyebrow {
  margin: 0 0 15px;

  color: #111;

  font-family: var(--font-ui--family);

  font-size: 18px;

  font-weight: 700;

  letter-spacing: .04em;

  line-height: 1;
}


.autodrape-hero__title {
  margin: 0;

  padding: 0;

  font-family: var(--font-heading--family);

  font-size: clamp(68px, 6.2vw, 96px);

  font-weight: 800;

  line-height: .88;

  letter-spacing: -.025em;

  text-transform: uppercase;
}


.autodrape-hero__title span {
  display: block;

  color: #111;

  font-family: var(--font-heading--family);

  font-weight: 800;

  font-style: italic;

  letter-spacing: -.02em;

  white-space: nowrap;
}


.autodrape-hero__title strong {
  display: block;

  margin-top: 8px;

  color: #a90000;

  font-family: var(--font-heading--family);

  font-weight: 800;

  font-style: normal;

  letter-spacing: -.025em;

  white-space: nowrap;
}


.autodrape-hero__shop-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: 26px;
  padding: 14px 22px;
  border-radius: 999px;
  background: #a90000;
  color: #fff;
  font-family: var(--font-ui--family);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .1em;
  text-decoration: none;
  text-transform: uppercase;
}


.autodrape-hero__shop-button span {
  font-size: 16px;
  line-height: 1;
}


.autodrape-hero__description {
  margin: 38px 0 0;

  color: #252525;

  font-family: var(--font-ui--family);

  font-size: 19px;

  font-weight: 500;

  line-height: 1.65;
}


/* =========================================================
   FINDER POSITION
   ========================================================= */

.autodrape-hero__finder-slot {
  position: absolute;

  z-index: 20;

  right: 7%;

  /*
    Raised higher to provide enough space below for native <select>
    dropdowns to open downward. Keeps the card visually inside the hero.
  */
  bottom: 120px;

  width: 43%;

  max-width: 700px;

  pointer-events: none;

  box-sizing: border-box;
}


.autodrape-hero__finder-slot > * {
  pointer-events: auto;
}


/* =========================================================
   FINDER CARD
   ========================================================= */

.autodrape-finder {
  width: 100%;

  padding: 20px 22px 19px;

  background: rgba(255,255,255,.98);

  border: 1px solid rgba(255,255,255,.9);

  border-radius: 16px;

  box-sizing: border-box;

  box-shadow:
    0 18px 45px rgba(0,0,0,.12),
    0 4px 12px rgba(0,0,0,.05);

  font-family: 'Montserrat', sans-serif;

  display: flex;

  flex-direction: column;

  gap: 14px;
}


/* =========================================================
   FINDER STEPS
   ========================================================= */

.autodrape-finder__steps {
  display: flex;

  align-items: center;

  justify-content: flex-start;

  gap: 8px;

  margin: 0;
}


.autodrape-finder__steps .step {
  display: flex;

  align-items: center;

  gap: 7px;

  padding: 6px 10px;

  border-radius: 999px;

  background: rgba(0,0,0,.025);

  color: #888;

  font-family: 'Montserrat', sans-serif;

  font-size: 11px;

  font-weight: 700;

  white-space: nowrap;
}


.autodrape-finder__steps .step .num {
  width: 28px;
  height: 28px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: #dedede;

  color: #666;

  font-size: 12px;

  font-weight: 800;
}


.autodrape-finder__steps .step.active {
  color: #a50000;

  background: rgba(165,0,0,.06);
}


.autodrape-finder__steps .step.active .num {
  background: #a50000;

  color: #fff;
}


/* =========================================================
   SELECT FIELDS
   ========================================================= */

.autodrape-finder__body {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 10px;

  width: 100%;
}


.autodrape-finder .field {
  min-width: 0;

  display: flex;

  flex-direction: column;

  gap: 6px;
}


.autodrape-finder .field label {
  display: block;

  color: #666;

  font-family: 'Montserrat', sans-serif;

  font-size: 10px;

  font-weight: 600;
}


.autodrape-finder .field select {
  width: 100%;

  height: 46px;

  padding: 0 12px;

  border: 1px solid #e1e1e1;

  border-radius: 8px;

  background: #fff;

  color: #222;

  font-family: 'Montserrat', sans-serif;

  font-size: 12px;

  font-weight: 500;

  box-sizing: border-box;

  outline: none;

  cursor: pointer;
}


.autodrape-finder .field select:focus {
  border-color: #a50000;

  box-shadow: 0 0 0 2px rgba(165,0,0,.08);
}


/* =========================================================
   FIND PRODUCTS BUTTON
   ========================================================= */

.autodrape-finder__cta {
  width: 100%;

  margin-top: 0;
}


.autodrape-finder .btn-find {
  width: 100%;

  height: 46px;

  border: 0;

  border-radius: 7px;

  background: #a50000;

  color: #fff;

  font-family: 'Montserrat', sans-serif;

  font-size: 13px;

  font-weight: 800;

  letter-spacing: .01em;

  cursor: pointer;

  transition:
    background .2s ease,
    transform .2s ease;
}


.autodrape-finder .btn-find:hover {
  background: #8c0000;

  transform: translateY(-1px);
}


/* =========================================================
   LARGE DESKTOP
   ========================================================= */

@media screen and (min-width: 1200px) {

  .autodrape-hero__finder-slot {
    right: 7%;

    bottom: 28px;

    width: 43%;

    max-width: 700px;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 1100px) {

  .autodrape-hero__inner {
    min-height: 600px;
  }


  .autodrape-hero__content {
    width: 50%;

    padding-left: 4%;

    padding-top: 65px;
  }


  .autodrape-hero__title {
    font-size: clamp(48px, 5.5vw, 70px);
  }


  .autodrape-hero__description {
    font-size: 16px;

    margin-top: 28px;
  }


  .autodrape-hero__finder-slot {
    right: 4%;

    bottom: 20px;

    width: 55%;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .autodrape-hero {
    min-height: auto;

    overflow: hidden;
  }


  .autodrape-hero__inner {
    min-height: auto;

    padding-bottom: 30px;
  }


  .autodrape-hero__content {
    width: 100%;

    padding: 45px 22px 0;

    text-align: center;
  }


  .autodrape-hero__eyebrow {
    font-size: 13px;

    margin-bottom: 12px;
  }


  .autodrape-hero__title {
    font-size: clamp(40px, 11vw, 58px);

    line-height: .95;
  }


  .autodrape-hero__title span,
  .autodrape-hero__title strong {
    white-space: normal;
  }


  .autodrape-hero__description {
    margin-top: 22px;

    font-size: 14px;

    line-height: 1.5;
  }


  .autodrape-hero__visual {
    position: relative;

    inset: auto;

    width: 100%;

    height: 280px;

    margin-top: 15px;
  }


  .autodrape-hero__car {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  .autodrape-hero__finder-slot {
    position: relative;

    right: auto;
    bottom: auto;

    width: calc(100% - 30px);

    max-width: none;

    margin: -30px auto 0;
  }


  .autodrape-finder {
    padding: 16px;

    border-radius: 12px;
  }


  .autodrape-finder__steps {
    gap: 4px;
  }


  .autodrape-finder__steps .step {
    padding: 5px 7px;

    font-size: 9px;
  }


  .autodrape-finder__steps .step .num {
    width: 25px;
    height: 25px;

    font-size: 10px;
  }


  .autodrape-finder__body {
    grid-template-columns: 1fr;

    gap: 10px;
  }

}

</style>


{% schema %}
{
  "name": "AutoDrape Hero",
  "tag": "section",
  "class": "autodrape-hero-section",
  "settings": [],
  "presets": [
    {
      "name": "AutoDrape Hero"
    }
  ]
}
{% endschema %}
