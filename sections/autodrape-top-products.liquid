<section class="autodrape-top-products">
  <div class="autodrape-top-products__inner">
    <div class="top-products__header">
      <h2>SHOP OUR <br/><span>TOP PRODUCTS</span></h2>
      <a href="/pages/all-products" class="view-all">VIEW ALL PRODUCTS →</a>
    </div>

    <div class="products-grid">
      {% liquid
        assign product_handles = 'front-window-shield,rear-window-shield,full-window-coverage-sunshades,half-window-coverae-sunshades' | split: ','
      %}
      {% for handle in product_handles %}
        {% assign product = all_products[handle] %}
        {% if product %}
          {% render 'product-card', product: product %}
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <style>
    .autodrape-top-products { padding: 36px 2%; background:#fff; }
    .autodrape-top-products__inner { max-width:1400px; margin:0 auto; }
    .top-products__header { position:relative; display:flex; justify-content:center; align-items:center; margin-bottom:18px; }
    .top-products__header h2 { margin:0; color:var(--ad-text); font-family:var(--font-ui--family) !important; font-size:clamp(28px, 2.8vw, 42px); line-height:1.08; font-weight:900; letter-spacing:-.05em; text-align:center; text-transform:uppercase; }
    .top-products__header h2 span { color:#d90000; }
    .top-products__header h2 br { display:none; }
    .top-products__header .view-all { position:absolute; right:0; bottom:4px; display:inline-flex; align-items:center; color:#d90000; font-family:var(--font-ui--family); font-size:12px; font-weight:900; letter-spacing:.05em; text-decoration:none; text-transform:uppercase; white-space:nowrap; transition:color .2s ease, transform .2s ease; }
    .top-products__header .view-all:hover { color:#850000; transform:translateX(3px); }

    .products-grid { display:grid; grid-template-columns: repeat(4, 1fr); gap:18px; }

    .product-card { display:flex; flex-direction:column; min-width:0; overflow:hidden; border:1px solid #eee; border-radius:8px; background:#fff; }
    .product-card__image { display:flex; align-items:center; justify-content:center; aspect-ratio:4 / 5; padding:12px; background:#f6f6f6; }
    .product-card__image img { width:100%; height:100%; object-fit:contain; }
    .product-card__body { display:flex; flex:1; flex-direction:column; gap:8px; padding:12px; }
    .product-card__name { margin:0; font-family:var(--font-ui--family); font-size:13px; font-weight:700; line-height:1.3; color:#222; }
    .product-card__desc { margin:0; font-family:var(--font-ui--family); font-size:12px; line-height:1.45; color:#666; }
    .product-card__price { margin:0; margin-top:auto; font-family:var(--font-ui--family); font-size:15px; font-weight:800; color:#a90000; }
    .product-card__btn { display:inline-block; padding:8px 10px; border-radius:6px; background:#d90000; color:#fff; font-family:var(--font-ui--family); font-size:13px; font-weight:700; text-align:center; text-decoration:none; }

    @media screen and (max-width:1100px) { .products-grid { grid-template-columns: repeat(2,1fr); } }
    @media screen and (max-width:749px) { .products-grid { grid-template-columns: repeat(2,1fr); } .product-card__image { padding:8px; } .top-products__header { position:static; flex-direction:column; gap:10px; align-items:center; } .top-products__header h2 br { display:block; } .top-products__header .view-all { position:static; align-self:center; } }
  </style>

{% schema %}
{
  "name": "AutoDrape Top Products",
  "settings": [],
  "presets": [{ "name": "AutoDrape Top Products" }]
}
{% endschema %}
