<section class="autodrape-why">
  <div class="autodrape-why__inner">
    <div class="why-left">
      <h2 class="why-title">WHY CHOOSE <span>AUTODRAPES?</span></h2>
      <p class="why-copy">We combine premium materials with precision fit to deliver unmatched protection and comfort for your car.</p>
      <a href="/pages/about" class="btn-learn">LEARN MORE</a>
    </div>

    <div class="why-right">
      <div class="why-card">
        <img src="{{ 'precisefit.png' | asset_url }}" alt="Precise Fit">
        <div class="why-card__overlay">
          <div class="why-card__title">PRECISE FIT</div>
          <div class="why-card__sub">Tailored for Your Car</div>
        </div>
      </div>

      <div class="why-card">
        <img src="{{ 'premiumaterials.png' | asset_url }}" alt="Premium Materials">
        <div class="why-card__overlay">
          <div class="why-card__title">PREMIUM MATERIALS</div>
          <div class="why-card__sub">Built to Last</div>
        </div>
      </div>

      <div class="why-card">
        <img src="{{ 'style.png' | asset_url }}" alt="Style & Comfort">
        <div class="why-card__overlay">
          <div class="why-card__title">STYLE & COMFORT</div>
          <div class="why-card__sub">For Every Drive</div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .autodrape-why { padding: 40px 2%; background: #fff; }
    .autodrape-why__inner { max-width: 1400px; margin: 0 auto; display:grid; grid-template-columns: 1fr 1.4fr; gap: 28px; align-items:center; }

    .why-left { padding: 12px 8px; }
    .why-title { font-family: var(--font-ui--family) !important; font-size: clamp(28px, 2.8vw, 42px); line-height: 1.08; font-weight: 900; letter-spacing: -.05em; text-transform: uppercase; margin: 0 0 14px; }
    .why-title span { color: #d90000; }
    .why-copy { color: #666; font-size: 15px; line-height:1.6; margin-bottom: 18px; max-width: 460px; }
    .btn-learn { display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:12px 20px; border:0; border-radius:999px; background:linear-gradient(180deg, #f23f38, var(--ad-accent)); color:#fff; text-decoration:none; font-family:var(--font-ui--family); font-size:11px; font-weight:800; letter-spacing:.12em; line-height:1; text-transform:uppercase; box-shadow:none; transition:transform .2s ease; }
    .btn-learn:hover { transform:translateY(-2px); box-shadow:none; }

    .why-right { display:flex; gap:18px; }
    .why-card { position: relative; height:280px; flex:1 1 0; border-radius:8px; overflow:hidden; background:#111; }
    .why-card img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
    .why-card__overlay { position:absolute; z-index:1; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:18px; background:linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,0.72) 100%); color:#fff; }
    .why-card__title { font-size:18px; font-weight:800; letter-spacing:0.02em; }
    .why-card__sub { font-size:13px; opacity:0.9; margin-top:6px; }

    @media screen and (max-width:1100px) { .autodrape-why__inner { grid-template-columns: 1fr 1fr; } }
    @media screen and (max-width:749px) { .autodrape-why__inner { grid-template-columns: 1fr; min-width:0; } .why-right { flex-direction:column; overflow:visible; padding-bottom:0; gap:14px; } .why-card { width:100%; min-width:0; height:220px; flex:0 0 auto; }
    .why-left { min-width:0; text-align:center; }
    .why-copy { width:100%; max-width:100%; overflow-wrap:anywhere; }
    .btn-learn { display:inline-flex; width:auto; min-width:0 !important; height:auto !important; min-height:0 !important; padding:12px 20px !important; box-sizing:border-box; }
    }
  </style>

{% schema %}
{
  "name": "Why Choose AutoDrape",
  "settings": [],
  "presets": [{ "name": "Why Choose AutoDrape" }]
}
{% endschema %}
