<section class="ad-final-cta">
  <div class="ad-final-cta__inner">
    <div class="ad-final-cta__eyebrow">Ready when you are</div>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>

    <div class="ad-final-cta__actions">
      <a href="{{ section.settings.primary_link }}" class="ad-final-cta__button ad-final-cta__button--primary">
        {{ section.settings.primary_label }}
        <span>></span>
      </a>

      <a href="{{ section.settings.secondary_link }}" class="ad-final-cta__button ad-final-cta__button--secondary">
        {{ section.settings.secondary_label }}
        <span>></span>
      </a>
    </div>
  </div>
</section>

<style>
  .ad-final-cta {
    width: 100%;
    padding: 12px 0 56px;
  }

  .ad-final-cta__inner {
    width: min(100% - 48px, 1200px);
    margin: 0 auto;
    padding: 36px 28px;
    text-align: center;
    border-radius: var(--ad-radius-xl);
    background:
      radial-gradient(circle at top left, rgba(216, 31, 25, 0.15), transparent 24%),
      linear-gradient(180deg, rgba(17, 17, 17, 0.98), rgba(11, 11, 13, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--ad-shadow-lg);
    color: #ffffff;
  }

  .ad-final-cta__eyebrow {
    margin-bottom: 10px;
    color: #f15d56;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ad-final-cta h2 {
    margin: 0;
    font-size: clamp(30px, 3vw, 52px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .ad-final-cta p {
    max-width: 620px;
    margin: 14px auto 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 15px;
    line-height: 1.7;
  }

  .ad-final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .ad-final-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .ad-final-cta__button:hover {
    transform: translateY(-2px);
  }

  .ad-final-cta__button--primary {
    background: linear-gradient(180deg, #f23f38, var(--ad-accent));
    color: #ffffff;
    box-shadow: 0 18px 30px rgba(216, 31, 25, 0.24);
  }

  .ad-final-cta__button--secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media screen and (max-width: 700px) {
    .ad-final-cta {
      padding-bottom: 44px;
    }

    .ad-final-cta__inner {
      width: calc(100% - 28px);
      padding: 28px 18px;
    }

    .ad-final-cta p {
      font-size: 13px;
    }

    .ad-final-cta__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .ad-final-cta__button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "AutoDrape Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right shade for your car today."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our full range, find your car, and choose a fit that looks premium from every angle."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop All Shades"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Find My Car"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "AutoDrape Final CTA"
    }
  ]
}
{% endschema %}
