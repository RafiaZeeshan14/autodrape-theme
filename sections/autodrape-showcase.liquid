<section class="ad-showcase">
  <div class="ad-showcase__container">
    <img
      class="ad-showcase__image"
      src="{{ 'premiumbuild.png' | asset_url }}"
      alt="AutoDrape sunshades"
      loading="lazy"
    >

    <div class="ad-showcase__overlay"></div>

    <div class="ad-showcase__content">
      <div class="ad-showcase__eyebrow">Premium Build</div>

      <h2>
        Made for your car.
        <span>Designed for protection.</span>
      </h2>

      <p>
        High quality, custom-fit sunshades for a cooler and more comfortable drive.
      </p>

      <a href="/pages/all-products" class="ad-showcase__button">
        Shop Now
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ad-showcase {
    width: 100%;
    color: #ffffff;
    background: #09090b;
  }

  .ad-showcase__container {
    position: relative;
    width: 100%;
    min-height: 360px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .ad-showcase__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.96) contrast(1.04);
    transform: scale(1.02);
  }

  .ad-showcase__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top left, rgba(216, 31, 25, 0.16), transparent 24%),
      linear-gradient(90deg, rgba(9, 9, 11, 0.96) 0%, rgba(9, 9, 11, 0.88) 34%, rgba(9, 9, 11, 0.26) 100%);
  }

  .ad-showcase__content {
    position: relative;
    z-index: 2;
    width: min(100% - 24px, 1320px);
    margin: 0 auto;
    padding: 56px 0;
  }

  .ad-showcase__eyebrow {
    display: inline-flex;
    padding: 8px 13px;
    margin-bottom: 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ad-showcase__content h2 {
    max-width: 540px;
    margin: 0;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .ad-showcase__content h2 span {
    color: #f15d56;
  }

  .ad-showcase__content p {
    max-width: 460px;
    margin: 14px 0 22px;
    color: rgba(255, 255, 255, 0.74);
    font-size: 14px;
    line-height: 1.7;
  }

  .ad-showcase__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .ad-showcase__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 124px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .ad-showcase__tab:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.14);
  }

  .ad-showcase__tab--active {
    background: linear-gradient(180deg, #f23f38, var(--ad-accent));
  }

  .ad-showcase__button {
    display: none;
  }

  .ad-showcase__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    background: linear-gradient(180deg, #f23f38, var(--ad-accent));
    color: #ffffff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 18px 30px rgba(216, 31, 25, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ad-showcase__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 36px rgba(216, 31, 25, 0.32);
  }

  .ad-showcase__button span {
    font-size: 14px;
    line-height: 1;
  }

  @media screen and (max-width: 900px) {
    .ad-showcase__content {
      width: calc(100% - 32px);
    }
  }

  @media screen and (max-width: 600px) {
    .ad-showcase__container {
      min-height: 420px;
      align-items: center;
    }

    .ad-showcase__image {
      object-position: 64% center;
    }

    .ad-showcase__overlay {
      background:
        radial-gradient(circle at 18% 20%, rgba(169, 0, 0, 0.18), transparent 32%),
        linear-gradient(180deg, rgba(9, 9, 11, 0.34) 0%, rgba(9, 9, 11, 0.68) 45%, rgba(9, 9, 11, 0.99) 100%);
    }

    .ad-showcase__content {
      width: calc(100% - 28px);
      padding: 24px 0;
      text-align: center;
    }

    .ad-showcase__eyebrow {
      margin-bottom: 20px;
      padding: 10px 16px;
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.24);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 12px 28px rgba(0, 0, 0, 0.12);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .ad-showcase__content h2 {
      font-size: clamp(28px, 8vw, 38px);
      line-height: 0.98;
      text-shadow: 0 3px 18px rgba(0, 0, 0, 0.28);
    }

    .ad-showcase__content h2 span {
      display: block;
      margin-top: 4px;
      color: #f05a54;
    }

    .ad-showcase__content p {
      max-width: 330px;
      margin-top: 18px;
      margin-right: auto;
      margin-left: auto;
      color: rgba(255, 255, 255, 0.82);
      font-size: 13px;
      line-height: 1.55;
    }

    .ad-showcase__button {
      min-width: 0;
      min-height: 0;
      margin-top: 0;
      padding: 12px 20px;
      background: linear-gradient(180deg, #f23f38, var(--ad-accent));
      box-shadow: 0 18px 30px rgba(216, 31, 25, 0.28);
    }

    .ad-showcase__tab {
      min-width: 110px;
    }
  }
</style>

{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
