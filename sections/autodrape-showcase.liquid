<section class="ad-showcase">
  <div class="ad-showcase__container">
    {% if section.settings.background_image != blank %}
      <img
        class="ad-showcase__image"
        src="{{ section.settings.background_image | image_url: width: 1800 }}"
        alt="AutoDrape sunshades"
        loading="lazy"
      >
    {% endif %}

    <div class="ad-showcase__overlay"></div>

    <div class="ad-showcase__content">
      <div class="ad-showcase__eyebrow">Premium Build</div>

      <h2>
        Made for your car.
        <span>Designed for protection.</span>
      </h2>

      <p>
        High quality, custom-fit sunshades for a cooler and more comfortable drive.
      </p>

      <div class="ad-showcase__tabs">
        <a href="/collections/full-shades" class="ad-showcase__tab ad-showcase__tab--active">Full Shades</a>
        <a href="/collections/half-shades" class="ad-showcase__tab">Half Shades</a>
        <a href="/collections/front-back-shades" class="ad-showcase__tab">Front + Back</a>
      </div>

      <a href="/collections/all" class="ad-showcase__button">
        Shop Now
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .ad-showcase {
    width: 100%;
    color: #ffffff;
    background: #09090b;
  }

  .ad-showcase__container {
    position: relative;
    width: 100%;
    min-height: 360px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .ad-showcase__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.96) contrast(1.04);
    transform: scale(1.02);
  }

  .ad-showcase__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top left, rgba(216, 31, 25, 0.16), transparent 24%),
      linear-gradient(90deg, rgba(9, 9, 11, 0.96) 0%, rgba(9, 9, 11, 0.88) 34%, rgba(9, 9, 11, 0.26) 100%);
  }

  .ad-showcase__content {
    position: relative;
    z-index: 2;
    width: min(100% - 48px, 1320px);
    margin: 0 auto;
    padding: 56px 0;
  }

  .ad-showcase__eyebrow {
    display: inline-flex;
    padding: 8px 13px;
    margin-bottom: 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ad-showcase__content h2 {
    max-width: 540px;
    margin: 0;
    font-size: clamp(34px, 3.6vw, 54px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.05em;
  }

  .ad-showcase__content h2 span {
    color: #f15d56;
  }

  .ad-showcase__content p {
    max-width: 460px;
    margin: 14px 0 22px;
    color: rgba(255, 255, 255, 0.74);
    font-size: 14px;
    line-height: 1.7;
  }

  .ad-showcase__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .ad-showcase__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 124px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .ad-showcase__tab:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.14);
  }

  .ad-showcase__tab--active {
    background: linear-gradient(180deg, #f23f38, var(--ad-accent));
  }

  .ad-showcase__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    background: linear-gradient(180deg, #f23f38, var(--ad-accent));
    color: #ffffff;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 18px 30px rgba(216, 31, 25, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ad-showcase__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 36px rgba(216, 31, 25, 0.32);
  }

  .ad-showcase__button span {
    font-size: 14px;
    line-height: 1;
  }

  @media screen and (max-width: 900px) {
    .ad-showcase__content {
      width: calc(100% - 32px);
    }
  }

  @media screen and (max-width: 600px) {
    .ad-showcase__container {
      min-height: 420px;
      align-items: flex-end;
    }

    .ad-showcase__image {
      object-position: 64% center;
    }

    .ad-showcase__overlay {
      background:
        linear-gradient(180deg, rgba(9, 9, 11, 0.14) 0%, rgba(9, 9, 11, 0.7) 45%, rgba(9, 9, 11, 0.98) 100%);
    }

    .ad-showcase__content {
      width: calc(100% - 28px);
      padding: 38px 0 30px;
    }

    .ad-showcase__content h2 {
      font-size: clamp(28px, 8vw, 38px);
    }

    .ad-showcase__content p {
      font-size: 12px;
    }

    .ad-showcase__tab {
      min-width: 110px;
    }
  }
</style>

{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
